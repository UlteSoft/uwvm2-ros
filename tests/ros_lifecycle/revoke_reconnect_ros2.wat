(module
  ;; Bounded source-only ROS2 revocation/fault/reconnection witness. Imports do
  ;; not grant authority. The parent grants only deadPub and livePub publish
  ;; aliases plus the WASI monotonic clock. Standard input/output are the basic
  ;; descriptors; the Guest receives no filesystem, sockets, environment,
  ;; process creation, graph access or native DDS credentials.
  (import "uwvm_ros2_v1" "capability_open" (func $open (param i32 i64 i64 i64) (result i32)))
  (import "uwvm_ros2_v1" "capability_close" (func $close (param i64) (result i32)))
  (import "uwvm_ros2_v1" "capability_revoke" (func $revoke (param i64) (result i32)))
  (import "uwvm_ros2_v1" "topic_publish" (func $publish (param i64 i32 i64 i64) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "clock_time_get" (func $clock (param i32 i64 i32) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $exit (param i32)))
  (memory (export "memory") 1 1)
  (global $started (mut i64) (i64.const 0))
  (data (i32.const 0) "deadPub")
  (data (i32.const 16) "livePub")
  ;; Canonical String payload: u32 little-endian UTF-8 byte count, then text.
  ;; Warmups create lazy native publishers and are not baseline side effects.
  (data (i32.const 4096) "\0b\00\00\00WARMUP-DEAD")
  (data (i32.const 4160) "\0b\00\00\00WARMUP-LIVE")
  (data (i32.const 4224) "\0b\00\00\00BEFORE-DEAD")
  (data (i32.const 4288) "\0b\00\00\00BEFORE-LIVE")
  (data (i32.const 4352) "\0a\00\00\00FAULT-LIVE")
  (data (i32.const 4416) "\10\00\00\00RECONNECT-WARMUP")
  (data (i32.const 4480) "\0a\00\00\00AFTER-LIVE")
  (data (i32.const 8192) "REVOKE_ENDPOINTS_CREATED\0a")
  (data (i32.const 8256) "BEFORE_MESSAGES_SENT\0a")
  (data (i32.const 8320) "REVOKED_STALE9_REOPEN125\0a")
  (data (i32.const 8384) "GATEWAY_FAULT107\0a")
  (data (i32.const 8448) "RECONNECT_ENDPOINT_CREATED\0a")
  (data (i32.const 8512) "AFTER_MESSAGE_SENT\0a")
  (data (i32.const 8576) "PASS_REVOKE_RECONNECT_GUEST\0a")

  (func $die (param $code i32) (call $exit (local.get $code)) unreachable)
  (func $require (param $condition i32) (param $code i32)
    (if (i32.eqz (local.get $condition)) (then (call $die (local.get $code)))))
  (func $expect (param $actual i32) (param $expected i32)
    (call $require (i32.eq (local.get $actual) (local.get $expected)) (i32.const 220)))
  (func $now (result i64)
    (i64.store (i32.const 184) (i64.const 0x1020304050607080))
    (i64.store (i32.const 192) (i64.const -1))
    (i64.store (i32.const 200) (i64.const 0x8070605040302010))
    (call $expect (call $clock (i32.const 1) (i64.const 1) (i32.const 192)) (i32.const 0))
    (call $require (i64.eq (i64.load (i32.const 184)) (i64.const 0x1020304050607080)) (i32.const 221))
    (call $require (i64.eq (i64.load (i32.const 200)) (i64.const 0x8070605040302010)) (i32.const 221))
    (call $require (i64.ne (i64.load (i32.const 192)) (i64.const -1)) (i32.const 221))
    (i64.load (i32.const 192)))
  (func $deadline (local $current i64)
    (local.set $current (call $now))
    (call $require (i64.ge_u (local.get $current) (global.get $started)) (i32.const 222))
    (call $require (i64.lt_u (i64.sub (local.get $current) (global.get $started)) (i64.const 60000000000)) (i32.const 222)))
  (func $iov (param $offset i32) (param $length i32)
    (i32.store (i32.const 156) (i32.const 0x55667788))
    (i32.store (i32.const 160) (local.get $offset))
    (i32.store (i32.const 164) (local.get $length))
    (i32.store (i32.const 168) (i32.const 0xdeadbeef))
    (i32.store (i32.const 172) (i32.const 0x99aabbcc)))
  (func $iov_checked (param $offset i32) (param $length i32)
    (call $require (i32.eq (i32.load (i32.const 156)) (i32.const 0x55667788)) (i32.const 223))
    (call $require (i32.eq (i32.load (i32.const 160)) (local.get $offset)) (i32.const 223))
    (call $require (i32.eq (i32.load (i32.const 164)) (local.get $length)) (i32.const 223))
    (call $require (i32.eq (i32.load (i32.const 168)) (local.get $length)) (i32.const 223))
    (call $require (i32.eq (i32.load (i32.const 172)) (i32.const 0x99aabbcc)) (i32.const 223)))
  (func $gate (param $byte i32)
    ;; The external owner enforces a deadline while fd_read blocks. On each
    ;; return the explicit monotonic right also checks this Guest's60s budget.
    (call $deadline)
    (i64.store (i32.const 176) (i64.const 0xa5a5a5a5a5a5a5a5))
    (call $iov (i32.const 176) (i32.const 1))
    (call $expect (call $read (i32.const 0) (i32.const 160) (i32.const 1) (i32.const 168)) (i32.const 0))
    (call $iov_checked (i32.const 176) (i32.const 1))
    (call $require (i64.eq (i64.load (i32.const 176))
      (i64.or (i64.const 0xa5a5a5a5a5a5a500) (i64.extend_i32_u (local.get $byte)))) (i32.const 224))
    (call $deadline))
  (func $emit (param $offset i32) (param $length i32)
    (call $iov (local.get $offset) (local.get $length))
    (call $expect (call $write (i32.const 1) (i32.const 160) (i32.const 1) (i32.const 168)) (i32.const 0))
    (call $iov_checked (local.get $offset) (local.get $length)))
  (func $handles (param $dead i64) (param $live i64)
    (call $require (i64.eq (i64.load (i32.const 56)) (i64.const 0x13579bdf2468ace0)) (i32.const 225))
    (call $require (i64.eq (i64.load (i32.const 64)) (local.get $dead)) (i32.const 225))
    (call $require (i64.eq (i64.load (i32.const 72)) (local.get $live)) (i32.const 225))
    (call $require (i64.eq (i64.load (i32.const 80)) (i64.const 0x02468ace13579bdf)) (i32.const 225)))
  (func $reopen_refused
    ;; A revoked alias stays revoked in this same Runtime instance even after
    ;; a new authenticated IPC connection. A rejected open changes no output.
    (i64.store (i32.const 88) (i64.const 0x1020304050607080))
    (i64.store (i32.const 96) (i64.const -1))
    (i64.store (i32.const 104) (i64.const 0x8070605040302010))
    (call $expect (call $open (i32.const 0) (i64.const 0) (i64.const 7) (i64.const 96)) (i32.const 125))
    (call $require (i64.eq (i64.load (i32.const 88)) (i64.const 0x1020304050607080)) (i32.const 226))
    (call $require (i64.eq (i64.load (i32.const 96)) (i64.const -1)) (i32.const 226))
    (call $require (i64.eq (i64.load (i32.const 104)) (i64.const 0x8070605040302010)) (i32.const 226)))

  (func (export "_start") (local $dead i64) (local $live i64)
    (global.set $started (call $now))
    ;; G is sent only after all three owned live ARM images are mapped. The
    ;; Runtime may already perform an authenticated, resource-free preflight.
    (call $gate (i32.const 0x47))
    (i64.store (i32.const 56) (i64.const 0x13579bdf2468ace0))
    (i64.store (i32.const 64) (i64.const -1))
    (i64.store (i32.const 72) (i64.const -1))
    (i64.store (i32.const 80) (i64.const 0x02468ace13579bdf))
    (call $expect (call $open (i32.const 0) (i64.const 0) (i64.const 7) (i64.const 64)) (i32.const 0))
    (local.set $dead (i64.load (i32.const 64)))
    (call $expect (call $open (i32.const 0) (i64.const 16) (i64.const 7) (i64.const 72)) (i32.const 0))
    (local.set $live (i64.load (i32.const 72)))
    (call $require (i64.ne (local.get $dead) (i64.const 0)) (i32.const 225))
    (call $require (i64.ne (local.get $dead) (i64.const -1)) (i32.const 225))
    (call $require (i64.ne (local.get $live) (i64.const 0)) (i32.const 225))
    (call $require (i64.ne (local.get $live) (i64.const -1)) (i32.const 225))
    (call $require (i64.ne (local.get $dead) (local.get $live)) (i32.const 225))
    (call $handles (local.get $dead) (local.get $live))
    (call $expect (call $publish (local.get $dead) (i32.const 0) (i64.const 4096) (i64.const 15)) (i32.const 0))
    (call $expect (call $publish (local.get $live) (i32.const 0) (i64.const 4160) (i64.const 15)) (i32.const 0))
    (call $emit (i32.const 8192) (i32.const 25))
    ;; B follows exact old native endpoint matching; these two baseline
    ;; messages must each be received exactly once from the old publisher GID.
    (call $gate (i32.const 0x42))
    (call $expect (call $publish (local.get $dead) (i32.const 0) (i64.const 4224) (i64.const 15)) (i32.const 0))
    (call $expect (call $publish (local.get $live) (i32.const 0) (i64.const 4288) (i64.const 15)) (i32.const 0))
    (call $emit (i32.const 8256) (i32.const 21))
    ;; R requires the independent baseline before revocation takes effect.
    (call $gate (i32.const 0x52))
    (call $expect (call $revoke (local.get $dead)) (i32.const 0))
    (call $expect (call $publish (local.get $dead) (i32.const 0) (i64.const 4224) (i64.const 15)) (i32.const 9))
    (call $reopen_refused)
    (call $handles (local.get $dead) (local.get $live))
    (call $emit (i32.const 8320) (i32.const 25))
    ;; F is released only after the old Gateway's exact owned birth has been
    ;; SIGKILLed and reaped. The established dead socket must return107, not a
    ;; tolerated timeout. The independent witness refuses any FAULT-LIVE byte.
    (call $gate (i32.const 0x46))
    (call $expect (call $publish (local.get $live) (i32.const 0) (i64.const 4352) (i64.const 14)) (i32.const 107))
    (call $handles (local.get $dead) (local.get $live))
    (call $emit (i32.const 8384) (i32.const 17))
    ;; C follows a fresh qualified Gateway socket bound to this same Worker.
    (call $gate (i32.const 0x43))
    (call $expect (call $publish (local.get $live) (i32.const 0) (i64.const 4416) (i64.const 20)) (i32.const 0))
    (call $emit (i32.const 8448) (i32.const 27))
    ;; A requires a different authenticated session and native publisher GID.
    (call $gate (i32.const 0x41))
    (call $expect (call $publish (local.get $dead) (i32.const 0) (i64.const 4224) (i64.const 15)) (i32.const 9))
    (call $reopen_refused)
    (call $expect (call $publish (local.get $live) (i32.const 0) (i64.const 4480) (i64.const 14)) (i32.const 0))
    (call $handles (local.get $dead) (local.get $live))
    ;; Q requires the independent native callback to have observed AFTER-LIVE
    ;; from the fresh writer GID. Publish success alone does not establish DDS
    ;; delivery, and this live publisher must survive until that observation.
    (call $emit (i32.const 8512) (i32.const 19))
    (call $gate (i32.const 0x51))
    (call $expect (call $close (local.get $live)) (i32.const 0))
    (call $expect (call $close (local.get $live)) (i32.const 9))
    (call $expect (call $close (local.get $dead)) (i32.const 9))
    (call $deadline)
    (call $emit (i32.const 8576) (i32.const 28))
    (call $exit (i32.const 0)) unreachable))
