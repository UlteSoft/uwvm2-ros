+            events.append({'line_number':number,'raw':line,'level':level,'operation':match[2],'cwd':directory});continue
+        if not text.startswith(('/usr/bin/gcc ','/usr/bin/g++ ','cd ')):continue
+        argv=shlex.split(text)
