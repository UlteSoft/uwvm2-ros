<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier><RuntimeFrameworkVersion>8.0.15</RuntimeFrameworkVersion>
    <AssemblyName>uwvm-csharp-record-contract</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <WasmBuildNative>true</WasmBuildNative><WasmSingleFileBundle>true</WasmSingleFileBundle>
    <InvariantGlobalization>true</InvariantGlobalization><InvariantTimezone>true</InvariantTimezone>
    <WasmNativeStrip>false</WasmNativeStrip><WasmNativeDebugSymbols>true</WasmNativeDebugSymbols>
    <DebugType>portable</DebugType><RunAOTCompilation>false</RunAOTCompilation><PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <Target Name="RequireActualRecordSources" BeforeTargets="CoreCompile">
    <Error Condition="'$(GeneratedRecords)' == '' Or !Exists('$(GeneratedRecords)')" Text="Supply the complete actual generated record source." />
    <Error Condition="'$(ContractSource)' == '' Or !Exists('$(ContractSource)')" Text="Supply the actual complete contract source." />
    <Error Condition="'$(RosWasmSdkRoot)' == '' Or !Exists('$(RosWasmSdkRoot)/Codecs.cs') Or !Exists('$(RosWasmSdkRoot)/Result.cs') Or !Exists('$(RosWasmSdkRoot)/Retirement.cs')" Text="Supply the actual SDK codec/interface/diagnostic sources." />
    <Error Condition="'$(RosBuildRoot)' == ''" Text="An exclusive fresh RosBuildRoot is required." />
  </Target>
  <ItemGroup>
    <Compile Include="$(GeneratedRecords)" /><Compile Include="$(ContractSource)" />
    <Compile Include="$(RosWasmSdkRoot)/Codecs.cs" /><Compile Include="$(RosWasmSdkRoot)/Result.cs" />
    <Compile Include="$(RosWasmSdkRoot)/Retirement.cs" />
  </ItemGroup>
</Project>
