<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><OutputType>Exe</OutputType><Nullable>enable</Nullable>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier><RuntimeFrameworkVersion>8.0.15</RuntimeFrameworkVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <WasmBuildNative>true</WasmBuildNative><WasmSingleFileBundle>true</WasmSingleFileBundle>
    <InvariantGlobalization>true</InvariantGlobalization><InvariantTimezone>true</InvariantTimezone>
    <WasmNativeStrip>false</WasmNativeStrip><WasmNativeDebugSymbols>true</WasmNativeDebugSymbols>
    <DebugType>portable</DebugType><RunAOTCompilation>false</RunAOTCompilation>
    <AssemblyName>uwvm-owned-$(RosOwnedExample)</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AppCommon.cs" />
    <Compile Include="TypeQuery.cs" Condition="'$(RosOwnedExample)' == 'TypeQuery'" />
    <Compile Include="Parameters.cs" Condition="'$(RosOwnedExample)' == 'Parameters'" />
    <ProjectReference Include="../Uwvm.RosWasm.Owned.csproj" AdditionalProperties="RosBackend=2;RosOwnedService=$(RosOwnedService);RosOwnedGeneratedDir=$(RosOwnedGeneratedDir);RuntimeIdentifier=wasi-wasm;RuntimeFrameworkVersion=8.0.15" />
  </ItemGroup>
  <Import Project="../NativeOwned.targets" />
  <Target Name="RequireOwnedExample" BeforeTargets="CoreCompile">
    <Error Condition="'$(RosOwnedExample)' != 'TypeQuery' And '$(RosOwnedExample)' != 'Parameters'" Text="Choose exactly TypeQuery or Parameters." />
    <Error Condition="'$(RosBuildRoot)' == ''" Text="An explicit fresh external build root is required." />
  </Target>
</Project>
