<Project>
  <Import Project="../NativeBridge.targets" />
  <Target Name="UwvmInjectOwnedBridge" AfterTargets="_GetNativeFilesForLinking" BeforeTargets="_GenerateManagedToNative">
    <Error Condition="'$(RosOwnedService)' != '1' Or '$(RosBackend)' != '2' Or '$(RuntimeIdentifier)' != 'wasi-wasm' Or '$(RuntimeFrameworkVersion)' != '8.0.15'" Text="The owned bridge is explicit ROS2 Mono/WASI8.0.15 only." />
    <Error Condition="'$(RosOwnedBridgeObject)' == '' Or !Exists('$(RosOwnedBridgeObject)')" Text="Supply the actual wasm32 roswasm_owned_bridge.o built from the reviewed C source." />
    <Error Condition="'$([System.IO.Path]::GetFileNameWithoutExtension('$(RosOwnedBridgeObject)'))' != 'roswasm_owned_bridge'" Text="The native object filename must match the DllImport module roswasm_owned_bridge." />
    <Error Condition="'$(RosNativeEvidenceDir)' == ''" Text="Explicit private evidence directory required." />
    <MakeDir Directories="$(RosNativeEvidenceDir)" />
    <ItemGroup><_WasmNativeFileForLinking Include="$(RosOwnedBridgeObject)" ScanForPInvokes="true" /></ItemGroup>
    <WriteLinesToFile File="$(RosNativeEvidenceDir)/owned-native-items.txt" Lines="@(_WasmNativeFileForLinking->'%(Identity)|%(FileName)|%(ScanForPInvokes)')" Overwrite="true" />
  </Target>
</Project>
