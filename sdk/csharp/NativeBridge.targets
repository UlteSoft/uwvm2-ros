<Project>
  <!-- Actual pinned Mono8.0.15 hook demonstrated by the separate generic interop lane.
       This candidate has not executed it with ROS. The exact same .o must be scanned and linked. -->
  <Target Name="UwvmInjectRosBridge" AfterTargets="_GetNativeFilesForLinking" BeforeTargets="_GenerateManagedToNative"
          Condition="'$(RuntimeIdentifier)' == 'wasi-wasm'">
    <Error Condition="'$(RosNativeBridgeObject)' == '' Or !Exists('$(RosNativeBridgeObject)')" Text="Supply the admitted matching roswasm_bridge.o." />
    <Error Condition="'$(RosNativeEvidenceDir)' == ''" Text="Supply an exclusive output evidence directory." />
    <ItemGroup><_WasmNativeFileForLinking Include="$(RosNativeBridgeObject)" ScanForPInvokes="true" /></ItemGroup>
    <MakeDir Directories="$(RosNativeEvidenceDir)" />
    <WriteLinesToFile File="$(RosNativeEvidenceDir)/native-items.txt"
      Lines="@(_WasmNativeFileForLinking->'%(Identity)|%(FileName)|%(ScanForPInvokes)')" Overwrite="true" />
  </Target>
</Project>
