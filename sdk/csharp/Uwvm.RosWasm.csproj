<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants Condition="'$(RosBackend)' == '1'">$(DefineConstants);UWVM_ROS1</DefineConstants>
    <DefineConstants Condition="'$(RosBackend)' == '2'">$(DefineConstants);UWVM_ROS2</DefineConstants>
  </PropertyGroup>
  <ItemGroup><Compile Include="RosWasm/**/*.cs" /></ItemGroup>
  <Target Name="RequireRosBackend" BeforeTargets="CoreCompile">
    <Error Condition="'$(RosBackend)' != '1' And '$(RosBackend)' != '2'" Text="Supply explicit RosBackend=1 or2 matching the one native bridge object." />
  </Target>
</Project>
