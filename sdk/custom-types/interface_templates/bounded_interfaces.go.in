// Code generated by bounded_profile.py. Put beside bounded_records.go in package
// customtypes. The go.mod must require uwvm2.local/roswasm and replace it with
// the real sdk/tinygo directory. Select exactly one actual ROS build tag.
// All operations require explicit aliases; no goroutine, clock or retry starts.
package customtypes

import("encoding/binary";"strings";ros "uwvm2.local/roswasm")

// RPCCleanup retains a primary failure and every one-attempt retirement result.
type RPCCleanup struct {Primary error;Results []error}
// RPCOpenError preserves the original open/advertise refusal plus full rollback.
type RPCOpenError struct {Primary error;Rollback RPCCleanup}
func(e *RPCOpenError)Error()string{return "custom RPC construction failed: "+e.Primary.Error()}
func(e *RPCOpenError)Unwrap()error{return e.Primary}
func rpcError(code uint32)error{return ros.Error{Code:code}}
func rpcID(bytes []byte)(uint64,error){if len(bytes)<8{return 0,rpcError(ros.Invalid)};id:=binary.LittleEndian.Uint64(bytes);if id==0{return 0,rpcError(ros.Invalid)};return id,nil}
func rpcFrame(id uint64,kind int,body []byte)[]byte{prefix:=8;if kind>=0{prefix=9};wire:=make([]byte,prefix+len(body));binary.LittleEndian.PutUint64(wire,id);if kind>=0{wire[8]=byte(kind)};copy(wire[prefix:],body);return wire}
func rpcIndex(values []uint64,id uint64)int{for i,value:=range values{if value==id{return i}};return -1}
func rpcRemove(values *[]uint64,id uint64){i:=rpcIndex(*values,id);if i>=0{last:=len(*values)-1;(*values)[i]=(*values)[last];(*values)[last]=0;*values=(*values)[:last]}}
func rpcOwns(values []uint64,id uint64)error{if id==0||rpcIndex(values,id)<0{return rpcError(ros.BadHandle)};return nil}

// Pointer state is shared by every accidental facade value copy. Capabilities
// stay private, so a callback cannot bypass this owner lease through Node/Session.
// Use one caller-driven execution context; this is not a goroutine-safe scheduler.
type rpcOwners struct{caps []*ros.Capability;busy bool;capacity int}
func rpcOpen(aliases []string,capacity int)(*rpcOwners,error){
 o:=&rpcOwners{capacity:capacity};fail:=func(err error)(*rpcOwners,error){return nil,&RPCOpenError{Primary:err,Rollback:o.cleanup(err,false)}}
 if capacity<1||capacity>1024||len(aliases)==0{return fail(rpcError(ros.Invalid))}
 for i,alias:=range aliases{if alias==""||len(alias)>255||strings.IndexByte(alias,0)>=0{return fail(rpcError(ros.Invalid))};for _,old:=range aliases[:i]{if old==alias{return fail(rpcError(ros.Invalid))}}}
 if ros.RawAbiVersion()!=1{return fail(rpcError(ros.Unsupported))}
 for _,alias:=range aliases{cap,err:=ros.Open(alias);if err!=nil{return fail(err)};o.caps=append(o.caps,cap)}
 return o,nil
}
func(o *rpcOwners)idle()error{if o==nil||len(o.caps)==0{return rpcError(ros.BadHandle)};if o.busy{return rpcError(ros.Conflict)};_,err:=o.caps[0].RawHandle();return err}
func(o *rpcOwners)cleanup(primary error,revoke bool)RPCCleanup{r:=RPCCleanup{Primary:primary};if o==nil{return r};if o.busy{r.Results=[]error{rpcError(ros.Conflict)};return r};for i:=len(o.caps)-1;i>=0;i--{if _,err:=o.caps[i].RawHandle();err==nil{if revoke{r.Results=append(r.Results,o.caps[i].Revoke())}else{r.Results=append(r.Results,o.caps[i].Close())}}};return r}
func(o *rpcOwners)request(index int,op ros.Operation,wire []byte,maximum int)([]byte,error){if o==nil||index<0||index>=len(o.caps){return nil,rpcError(ros.BadHandle)};out:=make([]byte,maximum);n,err:=o.caps[index].Request(op,wire,out);if err!=nil{return nil,err};return out[:int(n)],nil}
func(o *rpcOwners)zero(index int,op ros.Operation,wire []byte)error{out,err:=o.request(index,op,wire,0);if err!=nil{return err};if len(out)!=0{return rpcError(ros.Invalid)};return nil}
func(o *rpcOwners)poll(maximum int)([]byte,error){out:=make([]byte,maximum);n,err:=o.caps[0].Poll(out);if err!=nil{return nil,err};return out[:int(n)],nil}

type rpcService struct{owners *rpcOwners;pending []uint64;backend uint8;sequence,instance,session uint64}
func rpcServiceOpen(alias,observer string,version uint8,capacity int)(*rpcService,error){aliases:=[]string{alias};if observer!=""{aliases=append(aliases,observer)};o,err:=rpcOpen(aliases,capacity);if err!=nil{return nil,err};return &rpcService{owners:o,backend:version},nil}
func(c *rpcService)call(wire []byte,maximum int)([]byte,error){if err:=c.owners.idle();err!=nil{return nil,err};return c.owners.request(0,ros.OpServiceCall,wire,maximum)}
func(c *rpcService)submit(wire []byte)(uint64,error){if err:=c.owners.idle();err!=nil{return 0,err};if len(c.owners.caps)!=2{return 0,rpcError(ros.Denied)};if len(c.pending)==c.owners.capacity{return 0,rpcError(ros.TooLarge)};id,err:=c.owners.caps[0].SubmitService(c.owners.caps[1],wire);if err!=nil{return 0,err};if id==0||rpcIndex(c.pending,id)>=0{return 0,rpcError(ros.Invalid)};c.pending=append(c.pending,id);return id,nil}
// completion reads exactly one existing SDK envelope. The concrete decoder
// commits/removes correlation only after its complete generated value validates.
func(c *rpcService)completion(maximum int)(uint64,[]byte,uint32,error){
 if err:=c.owners.idle();err!=nil{return 0,nil,0,err};if len(c.owners.caps)!=2{return 0,nil,0,rpcError(ros.Denied)};out:=make([]byte,64+maximum);n,err:=c.owners.caps[1].PollEventV1(out);if err!=nil{return 0,nil,0,err};event,err:=ros.DecodeUnifiedEvent(out[:int(n)]);if err!=nil{return 0,nil,0,err};source,err:=c.owners.caps[0].RawHandle();if err!=nil{return 0,nil,0,err}
 if event.Backend!=c.backend||event.Source!=source||c.sequence==^uint64(0)||event.Sequence!=c.sequence+1||(c.sequence!=0&&(event.Instance!=c.instance||event.Session!=c.session)){return 0,nil,0,rpcError(ros.Invalid)}
 c.sequence,c.instance,c.session=event.Sequence,event.Instance,event.Session
 if event.Kind==ros.EventResourceClosed{return 0,nil,0,rpcError(ros.BadHandle)};if err:=rpcOwns(c.pending,event.Correlation);err!=nil{return 0,nil,0,err}
 if event.Kind==ros.EventResourceError{return event.Correlation,nil,event.Error,nil};if event.Kind!=ros.EventServiceResponse{return 0,nil,0,rpcError(ros.Invalid)};return event.Correlation,event.Body,0,nil
}
func(c *rpcService)cleanup(primary error,revoke bool)RPCCleanup{r:=c.owners.cleanup(primary,revoke);if !c.owners.busy{c.pending=nil};return r}

type rpcServer struct{owners *rpcOwners;live []uint64;action bool}
func rpcServerOpen(advertise,respond string,action bool,capacity int)(*rpcServer,error){o,err:=rpcOpen([]string{advertise,respond},capacity);if err!=nil{return nil,err};if action{err=o.zero(0,ros.OpActionAdvertise,nil)}else{err=o.caps[0].AdvertiseService()};if err!=nil{return nil,&RPCOpenError{Primary:err,Rollback:o.cleanup(err,false)}};return &rpcServer{owners:o,action:action},nil}
func(s *rpcServer)poll(maximum int)(uint64,[]byte,error){if len(s.live)==s.owners.capacity{return 0,nil,rpcError(ros.TooLarge)};wire,err:=s.owners.poll(maximum+8);if err!=nil{return 0,nil,err};id,err:=rpcID(wire);if err!=nil{return 0,nil,err};if rpcIndex(s.live,id)>=0{return 0,nil,rpcError(ros.Invalid)};return id,wire[8:],nil}
func(s *rpcServer)respond(id uint64,kind int,wire []byte)error{if err:=rpcOwns(s.live,id);err!=nil{return err};op:=ros.OpServiceRespond;if s.action{if kind<1||kind>4{return rpcError(ros.Invalid)};op=ros.OpActionRespond}else if kind!=-1{return rpcError(ros.Invalid)};if err:=s.owners.zero(1,op,rpcFrame(id,kind,wire));err!=nil{return err};if !s.action||kind!=1{rpcRemove(&s.live,id)};return nil}
func(s *rpcServer)cleanup(primary error,revoke bool)RPCCleanup{r:=s.owners.cleanup(primary,revoke);if !s.owners.busy{s.live=nil};return r}

type rpcAction struct{owners *rpcOwners;goals []uint64}
func rpcActionOpen(send,cancelOwn,feedback,result,cancelAny string,capacity int)(*rpcAction,error){aliases:=[]string{send,cancelOwn,feedback,result};if cancelAny!=""{aliases=append(aliases,cancelAny)};o,err:=rpcOpen(aliases,capacity);if err!=nil{return nil,err};return &rpcAction{owners:o},nil}
func(a *rpcAction)send(wire []byte)(uint64,error){if err:=a.owners.idle();err!=nil{return 0,err};if len(a.goals)==a.owners.capacity{return 0,rpcError(ros.TooLarge)};out,err:=a.owners.request(0,ros.OpActionSendGoal,wire,8);if err!=nil{return 0,err};if len(out)!=8{return 0,rpcError(ros.Invalid)};id,err:=rpcID(out);if err!=nil{return 0,err};if rpcIndex(a.goals,id)>=0{return 0,rpcError(ros.Invalid)};a.goals=append(a.goals,id);return id,nil}
func(a *rpcAction)cancel(id uint64,any bool)(bool,error){if err:=a.owners.idle();err!=nil{return false,err};index,op:=1,ros.OpActionCancelOwnGoal;if any{if len(a.owners.caps)!=5{return false,rpcError(ros.Denied)};index,op=4,ros.OpActionCancelAnyGoal}else if err:=rpcOwns(a.goals,id);err!=nil{return false,err};out,err:=a.owners.request(index,op,rpcFrame(id,-1,nil),1);if err!=nil{return false,err};if len(out)!=1||out[0]>1{return false,rpcError(ros.Invalid)};return out[0]==1,nil}
func(a *rpcAction)receive(id uint64,result bool,maximum int)([]byte,uint8,error){if err:=a.owners.idle();err!=nil{return nil,0,err};if err:=rpcOwns(a.goals,id);err!=nil{return nil,0,err};index,op,prefix:=2,ros.OpActionReceiveFeedback,8;if result{index,op,prefix=3,ros.OpActionReceiveResult,9};out,err:=a.owners.request(index,op,rpcFrame(id,-1,nil),maximum+prefix);if err!=nil{return nil,0,err};actual,err:=rpcID(out);if err!=nil||actual!=id||len(out)<prefix{return nil,0,rpcError(ros.Invalid)};kind:=uint8(1);if result{kind=out[8];if kind<2||kind>4{return nil,0,rpcError(ros.Invalid)}};return out[prefix:],kind,nil}
func(a *rpcAction)cleanup(primary error,revoke bool)RPCCleanup{r:=a.owners.cleanup(primary,revoke);if !a.owners.busy{a.goals=nil};return r}

