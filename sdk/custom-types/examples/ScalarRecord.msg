# Every explicitly supported scalar. Integer widths and signs remain exact.
# NaN and infinity are rejected in both native and guest codecs.
bool enabled
uint8 unsigned_small
int8 signed_small
uint16 unsigned_medium
int16 signed_medium
uint32 unsigned_word
int32 signed_word
uint64 unsigned_large
int64 signed_large
float32 single_value
float64 double_value
