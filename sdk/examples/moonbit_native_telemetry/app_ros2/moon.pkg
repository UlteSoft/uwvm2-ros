  "is-main": true,
  link: {
    "wasm": { "exports": [ "abi_coverage" ], "export-memory-name": "memory", "heap-start-address": 8519680, "memory-limits": { "min": 256, "max": 1024 } },
    "wasm-gc": { "exports": [ "abi_coverage" ], "export-memory-name": "memory", "use-js-builtin-string": false, "memory-limits": { "min": 256, "max": 1024 } },
  },
)
