<?xml version="1.0" encoding="UTF-8"?>
<!-- Compile from a /tmp copy. The SDK library does not select a main program or
     a backend; applications explicitly reach Ros1Transport or Ros2Transport.
     WASI builds must use TeaVM WEBASSEMBLY_WASI, never WEBASSEMBLY_GC. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.uwvm</groupId><artifactId>roswasm-java</artifactId><version>1.0.0</version>
  <properties><maven.compiler.release>17</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><teavm.version>0.13.1</teavm.version></properties>
  <dependencies><dependency><groupId>org.teavm</groupId><artifactId>teavm-interop</artifactId><version>${teavm.version}</version><scope>provided</scope></dependency></dependencies>
  <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version></plugin></plugins></build>
</project>
