// Compile/import inspection only. Never invoke a valid selector case.
// Zero arguments are deliberate placeholders, never a trusted alias/buffer.
pub fn abi_coverage(index : Int) -> Int {
  match index {
    0 => raw_abi_version()
    1 => raw_capability_open(0, 0UL, 0UL, 0UL)
    2 => raw_capability_close(0UL)
    3 => raw_capability_revoke(0UL)
    4 => raw_topic_publish(0UL, 0, 0UL, 0UL)
    5 => raw_topic_subscribe(0UL)
    6 => raw_event_poll(0UL, 0, 0UL, 0UL, 0UL)
    7 => raw_event_watch(0UL, 0UL, 0UL)
    8 => raw_event_poll_v1(0UL, 0, 0UL, 0UL, 0UL)
    9 => raw_event_ready(0UL, 0, 0UL)
    10 => raw_service_submit(0UL, 0UL, 0, 0UL, 0UL, 0UL)
    11 => raw_service_call(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    12 => raw_service_advertise(0UL)
    13 => raw_service_respond(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    14 => raw_action_send_goal(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    15 => raw_action_cancel_own_goal(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    16 => raw_action_cancel_any_goal(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    17 => raw_action_receive_feedback(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    18 => raw_action_receive_result(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    19 => raw_action_advertise(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    20 => raw_action_respond(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    21 => raw_tf_lookup(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    22 => raw_tf_broadcast(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    23 => raw_parameter_get(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    24 => raw_parameter_set(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    25 => raw_parameter_list(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    26 => raw_parameter_describe(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    27 => raw_parameter_declare(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    28 => raw_parameter_undeclare(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    29 => raw_graph_inspect_topic(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    30 => raw_graph_inspect_node(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    31 => raw_graph_inspect_service(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    32 => raw_graph_inspect_action(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    33 => raw_parameter_subscribe_events(0UL)
    34 => raw_graph_list_topics(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    35 => raw_graph_list_nodes(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    36 => raw_graph_list_services(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    37 => raw_lifecycle_get_state(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    38 => raw_lifecycle_change_state(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    39 => raw_time_read_ros(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    40 => raw_time_read_system(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    41 => raw_time_read_steady(0UL, 0, 0UL, 0UL, 0UL, 0UL, 0UL)
    42 => raw_log_write(0UL, 0, 0UL, 0UL)
    _ => 95
  }
}
