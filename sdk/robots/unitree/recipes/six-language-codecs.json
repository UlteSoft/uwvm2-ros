{
  "format": "uwvm-unitree-codec-recipes-v1",
  "status": "SOURCE_RECIPES_NOT_EXECUTED",
  "profiles": [
    "unitree_go",
    "unitree_hg",
    "unitree_api",
    "unitree_legged_msgs"
  ],
  "languages": {
    "c": "bounded_records.h",
    "cpp": "bounded_records.hpp",
    "rust": "bounded_records.rs",
    "javascript": "bounded_records.mjs",
    "tinygo": "bounded_records.go",
    "assemblyscript": "bounded_records.ts"
  },
  "guest_preparation": {
    "argv": [
      "python3",
      "-B",
      "{source}/sdk/robots/unitree/materialize_catalog.py",
      "--upstream-root",
      "{explicit-pinned-official-repository-root}",
      "--profile",
      "{source}/sdk/robots/unitree/profiles/{family}.json",
      "--lock",
      "{source}/sdk/robots/unitree/upstream-lock.json",
      "--out",
      "{fresh-preparation}"
    ],
    "then": [
      "python3",
      "-B",
      "{source}/sdk/tools/custom_types.py",
      "{fresh-preparation}/catalog.preparation.json",
      "--guest-only",
      "--out",
      "{fresh-generated}"
    ]
  },
  "native_binding": {
    "argv": [
      "python3",
      "-B",
      "{source}/tests/ros_custom_types/bounded-v2/bind_catalog.py",
      "--template",
      "{fresh-preparation}/catalog.preparation.json",
      "--native-metadata",
      "{qualified-official-native-export}",
      "--output",
      "{fresh-native-catalog}/catalog.native.json"
    ],
    "then": [
      "python3",
      "-B",
      "{source}/sdk/tools/custom_types.py",
      "{fresh-native-catalog}/catalog.native.json",
      "--out",
      "{fresh-native-generated}"
    ],
    "required": "Native export, complete official packages, same source/compiler/dependency closure and current runtime policy qualification are independent actual prerequisites."
  },
  "relocation": "Generated AS/JS imports are source-layout relative. Stage under sdk/custom-types/<fresh-family> beside existing SDK or rebase ONLY documented SDK relative imports in owned build-work copies, recording byte pins. Never overwrite historical generated codecs.",
  "limits": {
    "types": 128,
    "expanded_nodes_per_record": 4096,
    "expanded_nodes_total": 16384,
    "wire_bytes": 32768
  },
  "actual_build_and_native_tests": "NOT_RUN_BY_AUTHOR"
}
