<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><OutputType>Exe</OutputType><Nullable>enable</Nullable>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier><RuntimeFrameworkVersion>8.0.15</RuntimeFrameworkVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>uwvm-vendor-joint-state</AssemblyName>
    <RosJointStateMode Condition="'$(RosJointStateMode)' == ''">0</RosJointStateMode>
    <DefineConstants Condition="'$(RosBackend)' == '1'">$(DefineConstants);UWVM_ROS1</DefineConstants>
    <DefineConstants Condition="'$(RosBackend)' == '2'">$(DefineConstants);UWVM_ROS2</DefineConstants>
    <DefineConstants Condition="'$(RosJointStateMode)' == '1'">$(DefineConstants);UWVM_JOINT_STATE_POSITIVE</DefineConstants>
    <WasmBuildNative>true</WasmBuildNative><WasmSingleFileBundle>true</WasmSingleFileBundle>
    <InvariantGlobalization>true</InvariantGlobalization><InvariantTimezone>true</InvariantTimezone>
    <WasmNativeStrip>false</WasmNativeStrip><WasmNativeDebugSymbols>true</WasmNativeDebugSymbols>
    <DebugType>portable</DebugType><RunAOTCompilation>false</RunAOTCompilation><PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../../../custom-types/generated-official-standard-managed/csharp/BoundedRecords.cs" />
    <ProjectReference Include="../../../../../csharp/Uwvm.RosWasm.csproj" AdditionalProperties="RosBackend=$(RosBackend)" />
  </ItemGroup>
  <Import Project="../../../../../csharp/NativeBridge.targets" />
  <Target Name="RequireJointStateSelection" BeforeTargets="CoreCompile">
    <Error Condition="'$(RosBackend)' != '1' And '$(RosBackend)' != '2'" Text="RosBackend=1 or2 must match the actual C object." />
    <Error Condition="'$(RosJointStateMode)' != '0' And '$(RosJointStateMode)' != '1'" Text="RosJointStateMode must be0(default) or1(explicit fresh positive build)." />
    <Error Condition="'$(RosBuildRoot)' == ''" Text="An exclusive fresh RosBuildRoot is required." />
  </Target>
</Project>
