<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Aot.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType><AssemblyName>Uwvm.RosWasm.Aot</AssemblyName>
    <DefineConstants>$(DefineConstants);UWVM_ROS2;UWVM_ROSWASM_OWNED_SERVICE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RosSourceRoot)/sdk/csharp/RosWasm/*.cs" />
    <Compile Include="$(RosSourceRoot)/sdk/csharp/owned/NativeOwned.cs;$(RosSourceRoot)/sdk/csharp/owned/PreparedSession.cs;$(RosSourceRoot)/sdk/csharp/owned/OwnedWire.cs;$(RosSourceRoot)/sdk/csharp/owned/OwnedGroup.cs;$(RosSourceRoot)/sdk/csharp/owned/ControlWire.cs" />
    <Compile Include="$(RosOwnedGeneratedDir)/BoundedRecords.cs;$(RosOwnedGeneratedDir)/ControlRoots.cs" />
    <Compile Include="AotWitness.cs;ApplicationLifetime.cs" />
  </ItemGroup>
</Project>
