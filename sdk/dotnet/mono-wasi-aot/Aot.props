<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <RuntimeFrameworkVersion>9.0.0-preview.6.24327.7</RuntimeFrameworkVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RunAOTCompilation>true</RunAOTCompilation><WasmBuildNative>true</WasmBuildNative>
    <WasmSingleFileBundle>true</WasmSingleFileBundle><PublishTrimmed>true</PublishTrimmed>
    <WasmStripILAfterAOT>false</WasmStripILAfterAOT><WasmStripAOTAssemblies>false</WasmStripAOTAssemblies>
    <WasmNativeStrip>false</WasmNativeStrip><WasmNativeDebugSymbols>true</WasmNativeDebugSymbols>
    <WasmRunWasmOpt>false</WasmRunWasmOpt><WasmEnableThreads>false</WasmEnableThreads>
    <DebugType>portable</DebugType><DebugSymbols>true</DebugSymbols>
    <InvariantGlobalization>true</InvariantGlobalization><InvariantTimezone>true</InvariantTimezone>
    <DisableParallelAot>true</DisableParallelAot><DisableParallelEmccCompile>true</DisableParallelEmccCompile>
    <BuildInParallel>false</BuildInParallel><UseSharedCompilation>false</UseSharedCompilation>
    <NuGetAudit>false</NuGetAudit><RestoreIgnoreFailedSources>false</RestoreIgnoreFailedSources>
    <WasmAOTCompilerVerbose>true</WasmAOTCompilerVerbose>
  </PropertyGroup>
  <ItemGroup Condition="'$(RosAotRos)' == '1'"><TrimmerRootAssembly Include="Uwvm.RosWasm.Aot" /></ItemGroup>
  <Target Name="UwvmRequireResearchRoute" BeforeTargets="CoreCompile">
    <Error Condition="'$(RosAotOptIn)' != '1' Or ('$(RosAotRos)' != '0' And '$(RosAotRos)' != '1')" Text="Select explicit research AOT and exactly ROS0 or ROS1. Existing Mono8 remains separate." />
    <Error Condition="'$(RosAotRos)' == '1' And ('$(RosBackend)' != '2' Or '$(RosOwnedService)' != '1')" Text="Explicit ROS2 owned selection required for ROS example." />
    <Error Condition="'$(RosBuildRoot)' == '' Or '$(RosSourceRoot)' == ''" Text="Fresh separate build root and captured Source root required." />
    <Error Condition="'$(AOTMode)' != 'LLVMOnly' And '$(AOTMode)' != 'LLVMOnlyInterp'" Text="Select exactly LLVMOnly or LLVMOnlyInterp. Requested mode is not method coverage proof." />
    <Error Condition="'$(RuntimeIdentifier)' != 'wasi-wasm' Or '$(RuntimeFrameworkVersion)' != '9.0.0-preview.6.24327.7' Or '$(Configuration)' != 'Release'" Text="This Source route is the fixed Preview6 P1 research target in Release only." />
    <Error Condition="'$(RosAotRos)' == '1' And !Exists('$(RosOwnedGeneratedDir)/generation.control-csharp.json')" Text="Actual complete32/seven-root generated Source proof required." />
  </Target>
</Project>
