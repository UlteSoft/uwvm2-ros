# Invoke on the actual original rclcpp target AFTER its real add_library.
# The checked hpp/cpp hashes are the ACTUAL ADAPTED AFTER files, not their
# original preimages. Apply the exact external source patch before attachment.
# The Root-owned composite project hook must independently admit B/C/default
# endpoint closure; this function alone does not remove its existing refusal.
function(uwvm_attach_original_rclcpp_wasi_signal target)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "WASI" OR NOT TARGET "${target}")
    message(FATAL_ERROR "A real original rclcpp cross-target is required")
  endif()
  get_target_property(_imported "${target}" IMPORTED)
  get_target_property(_source "${target}" SOURCE_DIR)
  if(_imported OR NOT _source)
    message(FATAL_ERROR "Rebuild original rclcpp source; imported binaries are not admitted")
  endif()
  find_package(uwvm_rmw_threaded_platform REQUIRED)
  set(_platform uwvm_rmw_threaded_platform::uwvm_rmw_wasi_signal)
  if(NOT TARGET "${_platform}")
    message(FATAL_ERROR "Missing actual static signal target")
  endif()
  get_target_property(_admitted "${_platform}" UWVM_WASI_SIGNAL_ADMITTED)
  if(NOT _admitted STREQUAL "1")
    message(FATAL_ERROR "The actual pthread/Preview1/EH executable link probe is required")
  endif()
  foreach(_path CMakeLists.txt src/rclcpp/signal_handler.hpp src/rclcpp/signal_handler.cpp)
    if(NOT EXISTS "${_source}/${_path}")
      message(FATAL_ERROR "Missing complete original rclcpp source: ${_path}")
    endif()
    file(SHA256 "${_source}/${_path}" _observed)
    if(_path STREQUAL "CMakeLists.txt")
      set(_expected "a01f644852207f35f39c906e251e1c7ad0771e4b43e3b4f23eab5ee6593d6c89")
    elseif(_path STREQUAL "src/rclcpp/signal_handler.hpp")
      set(_expected "96258b1cea71c8197a5697cddc215fa9c2ed35e0d48d4be5b712cd7e829fc35d")
    else()
      set(_expected "2d09e2952718c76f0937981f4241ce70e83a3b8bd8da0309c56fcc79474c848f")
    endif()
    if(NOT _observed STREQUAL _expected)
      message(FATAL_ERROR "Fixed original/private source port mismatch: ${_path}")
    endif()
  endforeach()
  target_compile_definitions("${target}" PRIVATE UWVM_RCLCPP_WASI_SIGNAL_PORT=1)
  target_link_libraries("${target}" PUBLIC "${_platform}")
endfunction()
