# Explicit attachment only; this function writes no upstream file and supplies
# no RMW endpoint/Node bootstrap or authority. Apply the exact port to a fresh
# fixed original source copy first. Root's complete project hook remains separate.
function(uwvm_attach_original_rclcpp_c_service_lifecycle target)
 if(NOT TARGET "${target}")
  message(FATAL_ERROR "Actual source-built original rclcpp target required")
 endif()
 get_target_property(_imported "${target}" IMPORTED)
 get_target_property(_alias "${target}" ALIASED_TARGET)
 get_target_property(_source "${target}" SOURCE_DIR)
 if(_imported OR _alias OR NOT _source)
  message(FATAL_ERROR "Rebuild the real source target; no old imported/alias ABI")
 endif()
 foreach(_path CMakeLists.txt include/rclcpp/service.hpp include/rclcpp/any_service_callback.hpp)
  if(NOT EXISTS "${_source}/${_path}")
   message(FATAL_ERROR "Fixed original source member is missing: ${_path}")
  endif()
  file(SHA256 "${_source}/${_path}" _observed)
  if(_path STREQUAL "CMakeLists.txt")
   set(_expected "a01f644852207f35f39c906e251e1c7ad0771e4b43e3b4f23eab5ee6593d6c89")
  elseif(_path STREQUAL "include/rclcpp/service.hpp")
   set(_expected "c85eee5bb0b5e380eda020cf2d7202258d3af32d942292b8f7a0aabffb46d55b")
  else()
   set(_expected "c2b39640871d1c432a7342a050a6e66c9d70478c237423bbae9b79c0db78b457")
  endif()
  if(NOT _observed STREQUAL _expected)
   message(FATAL_ERROR "Whole fixed original C lifecycle port mismatch: ${_path}")
  endif()
 endforeach()
 find_package(uwvm_rmw_c_service_lifecycle REQUIRED)
 set(_helper uwvm_rmw_c_service_lifecycle::uwvm_rmw_c_service_lifecycle)
 if(NOT TARGET "${_helper}")
  message(FATAL_ERROR "Explicit enabled C lifecycle package is missing")
 endif()
 get_target_property(_link "${_helper}" UWVM_C_LIFECYCLE_LINK_ADMITTED)
 if(NOT _link STREQUAL "1")
  message(FATAL_ERROR "Actual C init/fini executable LINK closure required")
 endif()
 # PUBLIC is essential: Service/AnyServiceCallback are original templates in
 # application TUs too. A private-only flag would create inconsistent ownership.
 target_link_libraries("${target}" PUBLIC "${_helper}")
endfunction()
