# Explicit composition with the real A-created RMW target. No A/C source is
# overwritten and no replacement upstream header or fallback source is emitted.
# All B/C/adapters/app code MUST rebuild against the new codec.h state tail.
function(uwvm_rmw_attach_cpp_codecs target mode)
  if(NOT TARGET "${target}" OR NOT CMAKE_CXX_COMPILER_LOADED)
    message(FATAL_ERROR "Actual existing RMW target and CXX language are required")
  endif()
  if(NOT mode STREQUAL "STATIC_WASI" AND NOT mode STREQUAL "NATIVE_CONTRACT")
    message(FATAL_ERROR "Explicit STATIC_WASI or NATIVE_CONTRACT mode required")
  endif()
  get_property(_attached TARGET "${target}" PROPERTY UWVM_RMW_CPP_CODECS_ATTACHED)
  if(_attached)
    message(FATAL_ERROR "C++ codecs may be attached only once")
  endif()
  find_package(rosidl_cmake REQUIRED)
  find_package(rosidl_runtime_cpp REQUIRED)
  find_package(rosidl_typesupport_cpp REQUIRED)
  find_package(rosidl_typesupport_introspection_cpp REQUIRED)
  set(_real_targets)
  foreach(_package std_msgs std_srvs example_interfaces service_msgs builtin_interfaces)
    find_package(${_package} REQUIRED)
    foreach(_provider rosidl_typesupport_cpp rosidl_typesupport_introspection_cpp)
      # The original helper requires the in-build rosidl_generate_interfaces
      # target. Installed ament packages instead export namespaced targets.
      # Select only an actual existing target; never invent an imported shim.
      if(TARGET "${_package}::${_package}__${_provider}")
        set(_ts "${_package}::${_package}__${_provider}")
      elseif(TARGET "${_package}")
        rosidl_get_typesupport_target(_ts "${_package}" "${_provider}")
      else()
        message(FATAL_ERROR "Actual installed or in-tree ${_package} TypeSupport target missing")
      endif()
      if(NOT _ts OR NOT TARGET "${_ts}")
        message(FATAL_ERROR "Actual generated ${_package}/${_provider} target missing")
      endif()
      if(mode STREQUAL "STATIC_WASI")
        get_target_property(_type "${_ts}" TYPE)
        if(NOT _type STREQUAL "STATIC_LIBRARY")
          message(FATAL_ERROR "Guest requires actual static generated TypeSupport, not a dynamic loader")
        endif()
      endif()
      list(APPEND _real_targets "${_ts}")
    endforeach()
  endforeach()
  set(_base "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  if(NOT EXISTS "${_base}/src/cpp_codecs.cpp")
    message(FATAL_ERROR "Actual reviewed C++ codec source missing")
  endif()
  target_sources("${target}" PRIVATE "${_base}/src/cpp_codecs.cpp")
  target_compile_features("${target}" PUBLIC cxx_std_20)
  target_link_libraries("${target}" PUBLIC ${_real_targets})
  set_property(TARGET "${target}" PROPERTY UWVM_RMW_CPP_CODECS_ATTACHED TRUE)
  set_property(TARGET "${target}" PROPERTY UWVM_RMW_CPP_CODECS_MODE "${mode}")
endfunction()

# Explicit native component target, never an automatically executed test. The
# C accessor is used only to prove rejection of a real C-object TypeSupport;
# it must come from the actual generated C library, not a fake test provider.
function(uwvm_rmw_add_cpp_codec_contract output_target rmw_target)
  if(TARGET "${output_target}" OR NOT TARGET "${rmw_target}")
    message(FATAL_ERROR "Fresh contract target and actual RMW target required")
  endif()
  get_property(_mode TARGET "${rmw_target}" PROPERTY UWVM_RMW_CPP_CODECS_MODE)
  if(NOT _mode STREQUAL "NATIVE_CONTRACT")
    message(FATAL_ERROR "Native component contract requires explicit NATIVE_CONTRACT attachment")
  endif()
  if(TARGET std_msgs::std_msgs__rosidl_typesupport_c)
    set(_actual_c std_msgs::std_msgs__rosidl_typesupport_c)
  elseif(TARGET std_msgs)
    rosidl_get_typesupport_target(_actual_c std_msgs rosidl_typesupport_c)
  else()
    message(FATAL_ERROR "Actual generated std_msgs C TypeSupport missing")
  endif()
  if(NOT _actual_c OR NOT TARGET "${_actual_c}")
    message(FATAL_ERROR "Actual generated std_msgs C TypeSupport target missing")
  endif()
  add_executable("${output_target}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/cpp_codec_contract.cc")
  target_compile_features("${output_target}" PRIVATE cxx_std_20)
  target_link_libraries("${output_target}" PRIVATE "${rmw_target}" "${_actual_c}")
endfunction()
