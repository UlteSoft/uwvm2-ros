# Complete original Service table partitioning, independent of the owned RCL
# profile option. No new permissions, package selection or runtime endpoint.
include_guard(GLOBAL)
set_property(GLOBAL PROPERTY UWVM_ROS2_CUSTOM_SERVICES_SOURCE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}")
set(UWVM_ROS2_CUSTOM_SERVICE_SHARDS 32 CACHE STRING "Original custom ROS2 Service template partitions (1..256)")
function(uwvm_ros2_custom_service_sources target)
  if(NOT TARGET ${target})
    message(FATAL_ERROR "Custom ROS2 Service sources require an existing actual target")
  endif()
  get_property(already TARGET ${target} PROPERTY UWVM_ROS2_CUSTOM_SERVICES_SHARDED)
  if(already)
    message(FATAL_ERROR "Custom ROS2 Service sources were already added to ${target}")
  endif()
  if(NOT UWVM_ROS2_CUSTOM_SERVICE_SHARDS MATCHES "^[1-9][0-9]?[0-9]?$" OR UWVM_ROS2_CUSTOM_SERVICE_SHARDS GREATER 256)
    message(FATAL_ERROR "UWVM_ROS2_CUSTOM_SERVICE_SHARDS must be an integer in1..256")
  endif()
  get_property(service_source_directory GLOBAL PROPERTY UWVM_ROS2_CUSTOM_SERVICES_SOURCE_DIRECTORY)
  foreach(required custom_services.h custom_services_impl.h custom_services_dispatch.cc custom_services_shard.cc.in)
    if(NOT EXISTS "${service_source_directory}/${required}")
      message(FATAL_ERROR "Complete original Service shard source missing: ${required}")
    endif()
  endforeach()
  target_compile_definitions(${target} PRIVATE UWVM_ROS2_CUSTOM_SERVICE_SHARDS=${UWVM_ROS2_CUSTOM_SERVICE_SHARDS})
  target_include_directories(${target} PRIVATE "${service_source_directory}")
  target_sources(${target} PRIVATE "${service_source_directory}/custom_services_dispatch.cc")
  # Per-target directory avoids shared generated files between unrelated targets.
  # It does not select another provider: all definitions stay on this same target.
  string(MAKE_C_IDENTIFIER "${target}" service_target_component)
  set(service_shard_directory "${CMAKE_CURRENT_BINARY_DIR}/custom-service-shards/${service_target_component}")
  file(MAKE_DIRECTORY "${service_shard_directory}")
  math(EXPR last "${UWVM_ROS2_CUSTOM_SERVICE_SHARDS} - 1")
  foreach(UWVM_ROS2_CUSTOM_SERVICE_SHARD_INDEX RANGE 0 ${last})
    set(shard "${service_shard_directory}/custom_services_shard_${UWVM_ROS2_CUSTOM_SERVICE_SHARD_INDEX}.cc")
    configure_file("${service_source_directory}/custom_services_shard.cc.in" "${shard}" @ONLY)
    target_sources(${target} PRIVATE "${shard}")
  endforeach()
  set_property(TARGET ${target} PROPERTY UWVM_ROS2_CUSTOM_SERVICES_SHARDED TRUE)
endfunction()
