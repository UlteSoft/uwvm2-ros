function(uwvm_ros2_write_features)
  configure_file("${_uwvm_ros2_compat_dir}/uwvm_ros2_features.h.in" "${CMAKE_CURRENT_BINARY_DIR}/uwvm_ros2_features.h")
  set(_uwvm_json "{\n  \"format_version\": 1, \"backend\": \"ros2\", \"cxx_standard\": ${CMAKE_CXX_STANDARD},\n  \"features\": {")
  set(_uwvm_separator "")
  foreach(pair IN ITEMS "qos_class;QOS" "complete_rmw_qos;COMPLETE_RMW_QOS" "node_options;NODE_OPTIONS" "quiet_node;QUIET_NODE" "parameter_declare;PARAMETER_DECLARE" "dynamic_typing;DYNAMIC_TYPING" "post_set_parameters;POST_SET" "type_description;TYPE_DESCRIPTION" "deferred_service_callback;DEFERRED_SERVICE" "legacy_deferred_service;LEGACY_DEFERRED_SERVICE" "enclave_argument;ENCLAVE_ARGUMENT" "action;ACTION" "action_core;ACTION_CORE" "custom_action;CUSTOM_ACTION" "lifecycle;LIFECYCLE" "action_graph;ACTION_GRAPH" "tf_buffer;TF" "actual_service_qos;ACTUAL_SERVICE_QOS" "openssl_rihs;OPENSSL")
    list(GET pair 0 feature)
    list(GET pair 1 variable)
    set(value false)
    if(UWVM_ROS2_HAVE_${variable})
      set(value true)
    endif()
    string(APPEND _uwvm_json "${_uwvm_separator}\n    \"${feature}\": ${value}")
    set(_uwvm_separator ",")
  endforeach()
  string(APPEND _uwvm_json "\n  }\n}\n")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/uwvm_ros2_features.json.tmp" "${_uwvm_json}")
  file(RENAME "${CMAKE_CURRENT_BINARY_DIR}/uwvm_ros2_features.json.tmp" "${CMAKE_CURRENT_BINARY_DIR}/uwvm_ros2_features.json")
endfunction()
# Initial conservative custom value is replaced after exact provider selection.
uwvm_ros2_write_features()
set(CMAKE_REQUIRED_INCLUDES "${_uwvm_saved_required_includes}")
set(CMAKE_REQUIRED_LIBRARIES "${_uwvm_saved_required_libraries}")
if(_uwvm_saved_try_type)
  set(CMAKE_TRY_COMPILE_TARGET_TYPE "${_uwvm_saved_try_type}")
else()
  unset(CMAKE_TRY_COMPILE_TARGET_TYPE)
endif()
