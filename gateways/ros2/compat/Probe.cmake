# The trusted paired custom catalog is selected later in the top-level build.
# Its actual compile/link result is established by the function below, including
# an explicit failed empty-catalog probe when no Action was selected.
set(UWVM_ROS2_HAVE_CUSTOM_ACTION 0)
function(uwvm_ros2_probe_selected_custom_actions)
  set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
  set(CMAKE_REQUIRED_INCLUDES ${_uwvm_ros2_sdk_probe_includes} "${CMAKE_CURRENT_SOURCE_DIR}/../../sdk/include")
  set(CMAKE_REQUIRED_LIBRARIES ${_uwvm_ros2_sdk_probe_libraries})
  foreach(package IN LISTS UWVM_ROS_CUSTOM_ROS2_PACKAGES)
    list(APPEND CMAKE_REQUIRED_INCLUDES ${${package}_INCLUDE_DIRS})
    if(TARGET ${package}::${package})
      list(APPEND CMAKE_REQUIRED_LIBRARIES ${package}::${package})
    elseif(DEFINED ${package}_TARGETS AND NOT "${${package}_TARGETS}" STREQUAL "")
      list(APPEND CMAKE_REQUIRED_LIBRARIES ${${package}_TARGETS})
    else()
      list(APPEND CMAKE_REQUIRED_LIBRARIES ${${package}_LIBRARIES})
    endif()
  endforeach()
  if(UWVM_ROS2_HAVE_ACTION_CORE AND UWVM_ROS_CUSTOM_REGISTRY_HEADER AND UWVM_ROS_CUSTOM_ROS2_HEADER)
    # Top-level validation already rejects quotes, backslashes, newlines
    # and CMake list separators in these exact absolute include selections.
    # Both definitions are identical to those passed to every production TU.
    list(APPEND CMAKE_REQUIRED_DEFINITIONS
      "-DUWVM_ROS_CUSTOM_TOPIC_MANIFEST=\"${UWVM_ROS_CUSTOM_REGISTRY_HEADER}\""
      "-DUWVM_ROS_CUSTOM_ROS2_HEADER=\"${UWVM_ROS_CUSTOM_ROS2_HEADER}\"")
    set(_uwvm_custom_action_includes "#include \"compat/action_probe.h\"\n#include \"${UWVM_ROS_CUSTOM_ROS2_HEADER}\"\n#include \"compat/action_catalog.h\"\n#ifndef UWVM_ROS_CUSTOM_ROS2_ACTION_TYPES\n#error Selected native provider has no explicit Action macro\n#endif\n#define UWVM_ACTION_PROBE_ROW(Native,Type,Identity,Canonical,Goal,Result,Feedback) {Type,Identity,Canonical},\nconstexpr uwvm2::ros_gateway::ros2_compat::action_catalog_row selected_actions[]={UWVM_ROS_CUSTOM_ROS2_ACTION_TYPES(UWVM_ACTION_PROBE_ROW) {}};\n#undef UWVM_ACTION_PROBE_ROW\nconstexpr std::size_t selected_action_count=sizeof(selected_actions)/sizeof(selected_actions[0])-1;\nstatic_assert(uwvm2::imported::ros::ipc::custom_interface_registry_valid,\"Invalid common interface registry\");\nstatic_assert(uwvm2::ros_gateway::ros2_compat::action_catalog_matches(uwvm2::imported::ros::ipc::custom_action_entries(),selected_actions,selected_action_count),\"Empty, incomplete or mismatched custom Action catalog\");\n#define UWVM_ACTION_PROBE_COMPONENTS(Native,Type,Identity,Canonical,Goal,Result,Feedback) static_assert(uwvm2::ros_gateway::ros2_compat::action_components_match<Goal,Result,Feedback>(uwvm2::imported::ros::ipc::find_custom_action(2,Type)),\"Mismatched custom Action component codecs\");\nUWVM_ROS_CUSTOM_ROS2_ACTION_TYPES(UWVM_ACTION_PROBE_COMPONENTS)\n#undef UWVM_ACTION_PROBE_COMPONENTS")
    set(_uwvm_custom_action_body "auto node=std::make_shared<rclcpp::Node>(\"compile_only\");uwvm2::ros_gateway::ros2_compat::action_core_probe(node);\n#define UWVM_ACTION_PROBE_TYPE(Native,Type,Identity,Canonical,Goal,Result,Feedback) uwvm2::ros_gateway::ros2_compat::custom_action_lifecycle_probe<Native,Goal,Result,Feedback>(node);\nUWVM_ROS_CUSTOM_ROS2_ACTION_TYPES(UWVM_ACTION_PROBE_TYPE)\n#undef UWVM_ACTION_PROBE_TYPE")
  else()
    set(_uwvm_custom_action_includes "#error No public Action core or no explicitly paired custom provider headers")
    set(_uwvm_custom_action_body "")
  endif()
  uwvm_ros2_probe(UWVM_ROS2_HAVE_CUSTOM_ACTION "${_uwvm_custom_action_includes}" "${_uwvm_custom_action_body}")
  set(UWVM_ROS2_HAVE_CUSTOM_ACTION "${UWVM_ROS2_HAVE_CUSTOM_ACTION}" PARENT_SCOPE)
endfunction()

