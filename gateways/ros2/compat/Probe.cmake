# Public SDK compile AND link probes. No try_run, ROS context, target process or
# architecture assumption is used, including cross/QEMU/LoongArch builds.
include(CheckCXXSourceCompiles)
set(_uwvm_ros2_compat_dir "${CMAKE_CURRENT_LIST_DIR}")
file(REMOVE "${CMAKE_CURRENT_BINARY_DIR}/uwvm_ros2_features.json")
set(UWVM_ROS2_CXX_STANDARD AUTO CACHE STRING "Selected SDK C++ standard: AUTO, 17, 20 or 23")
set_property(CACHE UWVM_ROS2_CXX_STANDARD PROPERTY STRINGS AUTO 17 20 23)
set(UWVM_ROS2_BUILD_PROBES ON CACHE BOOL "Build available independent native witnesses")

# Old ament's macro uses the plain link signature. Keep the same signature on
# either route so later pthread/OpenSSL/custom dependencies cannot mix forms.
function(uwvm_ros2_dependencies target)
  if(COMMAND ament_target_dependencies)
    ament_target_dependencies(${target} ${ARGN})
  else()
    foreach(package IN LISTS ARGN)
      if(TARGET ${package}::${package})
        target_link_libraries(${target} ${package}::${package})
      elseif(DEFINED ${package}_TARGETS AND NOT "${${package}_TARGETS}" STREQUAL "")
        target_link_libraries(${target} ${${package}_TARGETS})
      elseif(DEFINED ${package}_LIBRARIES AND NOT "${${package}_LIBRARIES}" STREQUAL "")
        target_include_directories(${target} SYSTEM PRIVATE ${${package}_INCLUDE_DIRS})
        target_link_libraries(${target} ${${package}_LIBRARIES})
      else()
        message(FATAL_ERROR "Selected ROS2 package ${package} has no explicit supported link interface")
      endif()
    endforeach()
  endif()
endfunction()
set(_uwvm_saved_required_includes "${CMAKE_REQUIRED_INCLUDES}")
set(_uwvm_saved_required_libraries "${CMAKE_REQUIRED_LIBRARIES}")
set(_uwvm_saved_try_type "${CMAKE_TRY_COMPILE_TARGET_TYPE}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
set(CMAKE_REQUIRED_INCLUDES "${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/../.." "${CMAKE_CURRENT_SOURCE_DIR}/../../src")
set(CMAKE_REQUIRED_LIBRARIES "")
foreach(package IN ITEMS rclcpp rcl rmw std_srvs rcl_interfaces rclcpp_action action_tutorials_interfaces rcl_action lifecycle_msgs rosidl_typesupport_introspection_cpp tf2 tf2_ros tf2_msgs)
  if(${package}_FOUND)
    list(APPEND CMAKE_REQUIRED_INCLUDES ${${package}_INCLUDE_DIRS})
    if(TARGET ${package}::${package})
      list(APPEND CMAKE_REQUIRED_LIBRARIES ${package}::${package})
    elseif(DEFINED ${package}_TARGETS AND NOT "${${package}_TARGETS}" STREQUAL "")
      list(APPEND CMAKE_REQUIRED_LIBRARIES ${${package}_TARGETS})
    else()
      list(APPEND CMAKE_REQUIRED_LIBRARIES ${${package}_LIBRARIES})
    endif()
  endif()
endforeach()
set(_uwvm_ros2_sdk_probe_includes "${CMAKE_REQUIRED_INCLUDES}")
set(_uwvm_ros2_sdk_probe_libraries "${CMAKE_REQUIRED_LIBRARIES}")
if(UWVM_ROS2_CXX_STANDARD STREQUAL "AUTO")
  set(_uwvm_standards 17 20 23)
elseif(UWVM_ROS2_CXX_STANDARD MATCHES "^(17|20|23)$")
  set(_uwvm_standards ${UWVM_ROS2_CXX_STANDARD})
else()
  message(FATAL_ERROR "UWVM_ROS2_CXX_STANDARD must be AUTO, 17, 20 or 23")
endif()
set(_uwvm_standard_found FALSE)
foreach(standard IN LISTS _uwvm_standards)
  if(NOT _uwvm_standard_found)
    if(standard EQUAL 23 AND CMAKE_VERSION VERSION_LESS "3.20")
      continue()
    endif()
    set(CMAKE_CXX_STANDARD ${standard})
    set(CMAKE_CXX_STANDARD_REQUIRED ON)
    if(standard EQUAL 17)
      set(_uwvm_language_guard "__cplusplus >= 201703L && __cplusplus < 202002L")
    elseif(standard EQUAL 20)
      set(_uwvm_language_guard "__cplusplus >= 202002L && __cplusplus < 202100L")
    else()
      set(_uwvm_language_guard "__cplusplus >= 202100L && __cplusplus < 202400L")
    endif()
    unset(UWVM_ROS2_CXX_${standard} CACHE)
    check_cxx_source_compiles("#include <rclcpp/rclcpp.hpp>\n#include <string_view>\n#if !(${_uwvm_language_guard})\n#error Imported SDK changed the effective C++ standard\n#endif\nint main(){auto context=std::make_shared<rclcpp::Context>();std::string_view text{\"SDK\"};return !context||text.empty();}" UWVM_ROS2_CXX_${standard})
    if(UWVM_ROS2_CXX_${standard})
      set(_uwvm_standard_found TRUE)
      set(UWVM_ROS2_SELECTED_CXX_STANDARD ${standard})
    endif()
  endif()
endforeach()
if(NOT _uwvm_standard_found)
  message(FATAL_ERROR "Compiler/target library cannot compile and link this ROS2 SDK with C++17/20/23")
endif()
set(CMAKE_CXX_STANDARD ${UWVM_ROS2_SELECTED_CXX_STANDARD})
set(CMAKE_CXX_STANDARD_REQUIRED ON)
function(uwvm_ros2_probe name includes body)
  # Cache invalidation is deliberate: an SDK, compiler, sysroot or ABI may have
  # changed even when the caller reuses a build directory. main is linked but
  # NEVER run. Statements force relevant constructor/method symbol references.
  set(_uwvm_result "${name}_COMPILE_LINK")
  unset(${_uwvm_result} CACHE)
  unset(${_uwvm_result})
  check_cxx_source_compiles("#include <rclcpp/rclcpp.hpp>\n#include <utility>\n${includes}\nint main(){${body}\nreturn 0;}" ${_uwvm_result})
  set(${name} "${${_uwvm_result}}" PARENT_SCOPE)
endfunction()
