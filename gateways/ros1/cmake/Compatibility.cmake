# Feature admission for an explicitly selected ROS1 development SDK. These
# checks compile/link target code but never run it; an old ROS userland may be
# used with a modern compiler/sysroot on any supported target architecture.
include(CheckCXXSourceCompiles)
# A failed reconfiguration must not leave an earlier SDK's feature record as
# apparently current metadata. Publish a new closed record only after every
# required contract has compiled and linked successfully.
file(REMOVE "${CMAKE_CURRENT_BINARY_DIR}/uwvm_ros1_features.json")
unset(UWVM_ROS1_SELECTED_CXX11_ABI CACHE)
# A caller may use STATIC_LIBRARY try-compiles for a freestanding toolchain.
# That would not prove compatibility with prebuilt ROS libraries. Force an
# executable link for this scoped admission, then restore the caller's setting.
set(_uwvm_ros1_saved_try_compile_type "${CMAKE_TRY_COMPILE_TARGET_TYPE}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)

set(UWVM_ROS1_CXX11_ABI "auto" CACHE STRING "libstdc++ string ABI: auto, 0, or 1; verified by a roscpp link probe")
set_property(CACHE UWVM_ROS1_CXX11_ABI PROPERTY STRINGS auto 0 1)
if(NOT UWVM_ROS1_CXX11_ABI MATCHES "^(auto|0|1)$")
    message(FATAL_ERROR "UWVM_ROS1_CXX11_ABI must be auto, 0 or 1")
endif()
set(UWVM_ROS1_GENERATOR_PYTHON "" CACHE FILEPATH "Host Python interpreter for the selected ROS1 gencpp/genmsg environment")
set(UWVM_ROS1_GENCPP_SCRIPT "" CACHE FILEPATH "Explicit selected-SDK gen_cpp.py, needed only for missing standard services")
set(UWVM_ROS1_GENCPP_TEMPLATE_DIR "" CACHE PATH "Explicit selected-SDK gencpp template directory")

set(CMAKE_REQUIRED_INCLUDES ${catkin_INCLUDE_DIRS} "${CMAKE_CURRENT_SOURCE_DIR}")
set(CMAKE_REQUIRED_LIBRARIES pthread)
set(CMAKE_REQUIRED_DEFINITIONS "")
set(_uwvm_ros1_probe_dir "${CMAKE_CURRENT_SOURCE_DIR}/cmake/probes")

# SDK/compiler/ABI inputs can change in an existing build directory. Do not
# inherit a cached success from another SDK or an earlier compiler selection.
function(uwvm_ros1_compile_contract source result)
    file(READ "${_uwvm_ros1_probe_dir}/${source}" _uwvm_probe)
    unset(${result} CACHE)
    check_cxx_source_compiles("${_uwvm_probe}" ${result})
    set(${result} "${${result}}" PARENT_SCOPE)
endfunction()

uwvm_ros1_compile_contract(cxx17.cc UWVM_ROS1_CXX17_LIBRARY)
if(NOT UWVM_ROS1_CXX17_LIBRARY)
    message(FATAL_ERROR "ROS1 Gateway needs a target C++17 compiler/library with optional, string_view and integer charconv. Supply a modern compiler and compatible target sysroot; lowering -std does not implement this adapter.")
endif()

set(CMAKE_REQUIRED_LIBRARIES ${catkin_LIBRARIES} pthread)
set(_uwvm_ros1_abi_definition "")
if(UWVM_ROS1_CXX11_ABI STREQUAL "auto")
    uwvm_ros1_compile_contract(ros_link.cc UWVM_ROS1_DEFAULT_ABI_LINK)
    if(NOT UWVM_ROS1_DEFAULT_ABI_LINK)
        # GCC 5's dual string ABI is independent of -std. Older prebuilt ROS
        # libraries often require ABI 0 even with a modern C++17 compiler. Pick
        # a fallback only if exactly one actual target link succeeds; do not
        # infer the answer from a distro name or execute the target binary.
        foreach(_uwvm_abi 0 1)
            set(CMAKE_REQUIRED_DEFINITIONS "-D_GLIBCXX_USE_CXX11_ABI=${_uwvm_abi}")
            uwvm_ros1_compile_contract(ros_link.cc UWVM_ROS1_ABI_${_uwvm_abi}_LINK)
        endforeach()
        if(UWVM_ROS1_ABI_0_LINK AND NOT UWVM_ROS1_ABI_1_LINK)
            set(_uwvm_ros1_abi_definition "_GLIBCXX_USE_CXX11_ABI=0")
        elseif(UWVM_ROS1_ABI_1_LINK AND NOT UWVM_ROS1_ABI_0_LINK)
            set(_uwvm_ros1_abi_definition "_GLIBCXX_USE_CXX11_ABI=1")
        else()
            message(FATAL_ERROR "No unambiguous roscpp string ABI link. Inspect CMakeError.log, select UWVM_ROS1_CXX11_ABI explicitly and provide the SDK's target libraries/sysroot.")
        endif()
    endif()
else()
    set(_uwvm_ros1_abi_definition "_GLIBCXX_USE_CXX11_ABI=${UWVM_ROS1_CXX11_ABI}")
    set(CMAKE_REQUIRED_DEFINITIONS "-D${_uwvm_ros1_abi_definition}")
    uwvm_ros1_compile_contract(ros_link.cc UWVM_ROS1_EXPLICIT_ABI_LINK)
    if(NOT UWVM_ROS1_EXPLICIT_ABI_LINK)
        message(FATAL_ERROR "Selected ROS1 string ABI does not link to this SDK; no target code was run")
    endif()
endif()
set(CMAKE_REQUIRED_DEFINITIONS "")
if(_uwvm_ros1_abi_definition)
    list(APPEND CMAKE_REQUIRED_DEFINITIONS "-D${_uwvm_ros1_abi_definition}")
    target_compile_definitions(uwvm-ros1-sdk INTERFACE "${_uwvm_ros1_abi_definition}")
endif()
set(_uwvm_ros1_abi_probe_definitions ${CMAKE_REQUIRED_DEFINITIONS})
foreach(_uwvm_abi 0 1)
    set(CMAKE_REQUIRED_DEFINITIONS ${_uwvm_ros1_abi_probe_definitions} "-DUWVM_ROS1_EXPECT_CXX11_ABI=${_uwvm_abi}")
    uwvm_ros1_compile_contract(stdlib_abi.cc UWVM_ROS1_SELECTED_ABI_${_uwvm_abi})
endforeach()
set(CMAKE_REQUIRED_DEFINITIONS ${_uwvm_ros1_abi_probe_definitions})
if(UWVM_ROS1_SELECTED_ABI_0 AND NOT UWVM_ROS1_SELECTED_ABI_1)
    set(UWVM_ROS1_SELECTED_CXX11_ABI "0" CACHE STRING "Actual target libstdc++ string ABI, or NOT_LIBSTDCXX" FORCE)
elseif(UWVM_ROS1_SELECTED_ABI_1 AND NOT UWVM_ROS1_SELECTED_ABI_0)
    set(UWVM_ROS1_SELECTED_CXX11_ABI "1" CACHE STRING "Actual target libstdc++ string ABI, or NOT_LIBSTDCXX" FORCE)
elseif(NOT UWVM_ROS1_SELECTED_ABI_0 AND NOT UWVM_ROS1_SELECTED_ABI_1 AND NOT _uwvm_ros1_abi_definition)
    uwvm_ros1_compile_contract(stdlib_libcxx.cc UWVM_ROS1_SELECTED_LIBCXX)
    if(NOT UWVM_ROS1_SELECTED_LIBCXX)
        message(FATAL_ERROR "Cannot positively identify the selected target string-library ABI")
    endif()
    set(UWVM_ROS1_SELECTED_CXX11_ABI "NOT_LIBSTDCXX" CACHE STRING "Actual target libstdc++ string ABI, or NOT_LIBSTDCXX" FORCE)
else()
    message(FATAL_ERROR "Selected target headers do not verify the requested libstdc++ ABI")
endif()

# The native header wins independently for each service. Early SDK snapshots
# have Empty but no Trigger/SetBool. Generate only a missing service from the
# vendored official .srv text, using that SDK's real gencpp and templates. This
# is an output-owned generated header overlay, never a replacement native
# library, fake message trait, runtime plugin or additional capability grant.
set(_uwvm_ros1_fallback_include "${CMAKE_CURRENT_BINARY_DIR}/compat-generated/include")
set(_uwvm_ros1_missing_services "")
foreach(_uwvm_service Trigger SetBool)
    # Follow the actual target -I order exactly. find_path's cross-root search
    # transformation could otherwise select a different header than the one
    # the compiler sees in an already sysroot-qualified SDK include directory.
    set(_uwvm_native_service_dir "")
    foreach(_uwvm_include IN LISTS catkin_INCLUDE_DIRS)
        if(EXISTS "${_uwvm_include}/std_srvs/${_uwvm_service}.h" AND
           NOT IS_DIRECTORY "${_uwvm_include}/std_srvs/${_uwvm_service}.h")
            set(_uwvm_native_service_dir "${_uwvm_include}")
            break()
        endif()
    endforeach()
    if(_uwvm_native_service_dir)
        set(_uwvm_service_header_${_uwvm_service} "${_uwvm_native_service_dir}/std_srvs/${_uwvm_service}.h")
    else()
        list(APPEND _uwvm_ros1_missing_services ${_uwvm_service})
        set(_uwvm_service_header_${_uwvm_service} "${_uwvm_ros1_fallback_include}/std_srvs/${_uwvm_service}.h")
    endif()
endforeach()
if(_uwvm_ros1_missing_services)
    if(NOT UWVM_ROS1_GENCPP_SCRIPT OR NOT UWVM_ROS1_GENCPP_TEMPLATE_DIR)
        if(UWVM_ROS1_DISCOVERY STREQUAL "CATKIN")
            find_package(gencpp REQUIRED)
            if(NOT UWVM_ROS1_GENCPP_SCRIPT)
                set(UWVM_ROS1_GENCPP_SCRIPT "${GENCPP_BIN}")
            endif()
            if(NOT UWVM_ROS1_GENCPP_TEMPLATE_DIR)
                set(UWVM_ROS1_GENCPP_TEMPLATE_DIR "${GENCPP_TEMPLATE_DIR}")
            endif()
        else()
            message(FATAL_ERROR "An explicit legacy SDK missing Trigger/SetBool needs UWVM_ROS1_GENCPP_SCRIPT and UWVM_ROS1_GENCPP_TEMPLATE_DIR")
        endif()
    endif()
    if(NOT UWVM_ROS1_GENERATOR_PYTHON)
        # catkin's selected Python may be Python 2 on old ROS SDKs. Keep this
        # distinct from the modern host Python used by our acceptance tools.
        if(PYTHON_EXECUTABLE)
            set(UWVM_ROS1_GENERATOR_PYTHON "${PYTHON_EXECUTABLE}")
        else()
            message(FATAL_ERROR "Select UWVM_ROS1_GENERATOR_PYTHON for this SDK's gencpp/genmsg environment")
        endif()
    endif()
    foreach(_uwvm_host_file UWVM_ROS1_GENERATOR_PYTHON UWVM_ROS1_GENCPP_SCRIPT)
        if(NOT IS_ABSOLUTE "${${_uwvm_host_file}}" OR NOT EXISTS "${${_uwvm_host_file}}" OR IS_DIRECTORY "${${_uwvm_host_file}}")
            message(FATAL_ERROR "${_uwvm_host_file} must name an existing absolute host file")
        endif()
    endforeach()
    if(NOT IS_ABSOLUTE "${UWVM_ROS1_GENCPP_TEMPLATE_DIR}" OR NOT IS_DIRECTORY "${UWVM_ROS1_GENCPP_TEMPLATE_DIR}")
        message(FATAL_ERROR "UWVM_ROS1_GENCPP_TEMPLATE_DIR must name an existing absolute host directory")
    endif()
    foreach(_uwvm_template msg.h.template srv.h.template)
        if(NOT EXISTS "${UWVM_ROS1_GENCPP_TEMPLATE_DIR}/${_uwvm_template}")
            message(FATAL_ERROR "Missing selected-SDK gencpp template ${_uwvm_template}")
        endif()
    endforeach()
    foreach(_uwvm_service IN LISTS _uwvm_ros1_missing_services)
        set(_uwvm_definition "${CMAKE_CURRENT_SOURCE_DIR}/compat/std_srvs/${_uwvm_service}.srv")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_uwvm_definition}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env PYTHONDONTWRITEBYTECODE=1
            "${UWVM_ROS1_GENERATOR_PYTHON}" -B "${UWVM_ROS1_GENCPP_SCRIPT}"
            "${_uwvm_definition}" -p std_srvs -o "${_uwvm_ros1_fallback_include}/std_srvs"
            -e "${UWVM_ROS1_GENCPP_TEMPLATE_DIR}"
            TIMEOUT 120 RESULT_VARIABLE _uwvm_generated OUTPUT_VARIABLE _uwvm_generator_stdout ERROR_VARIABLE _uwvm_generator_stderr)
        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/compat-${_uwvm_service}-generator.log"
            "${_uwvm_generator_stdout}${_uwvm_generator_stderr}")
        if(NOT "${_uwvm_generated}" STREQUAL "0")
            message(FATAL_ERROR "Selected-SDK gencpp failed for ${_uwvm_service}; inspect compat-${_uwvm_service}-generator.log")
        endif()
        foreach(_uwvm_suffix "" Request Response)
            if(NOT EXISTS "${_uwvm_ros1_fallback_include}/std_srvs/${_uwvm_service}${_uwvm_suffix}.h")
                message(FATAL_ERROR "Selected-SDK gencpp omitted ${_uwvm_service}${_uwvm_suffix}.h")
            endif()
        endforeach()
    endforeach()
    # AFTER preserves existing SDK headers when only one service was missing.
    target_include_directories(uwvm-ros1-sdk INTERFACE "${_uwvm_ros1_fallback_include}")
    list(APPEND CMAKE_REQUIRED_INCLUDES "${_uwvm_ros1_fallback_include}")
endif()

foreach(_uwvm_service Trigger SetBool)
    if(_uwvm_service STREQUAL "Trigger")
        set(_uwvm_expected_md5 "937c9679a518e3a18d831e57125ea522")
    else()
        set(_uwvm_expected_md5 "09fb03525b03e7ea1fd3992bafd87e16")
    endif()
    file(READ "${_uwvm_service_header_${_uwvm_service}}" _uwvm_service_header)
    if(NOT _uwvm_service_header MATCHES "return[ \t\r\n]+\"${_uwvm_expected_md5}\"[ \t\r\n]*;" OR
       NOT _uwvm_service_header MATCHES "return[ \t\r\n]+\"std_srvs/${_uwvm_service}\"[ \t\r\n]*;")
        message(FATAL_ERROR "Selected ${_uwvm_service} header is not the official standard-service type/MD5")
    endif()
endforeach()

uwvm_ros1_compile_contract(tf_modern.cc UWVM_ROS1_TF_MODERN_LINK)
if(UWVM_ROS1_TF_MODERN_LINK)
    set(_uwvm_ros1_tf_feature "tf2_ros::Buffer")
else()
    uwvm_ros1_compile_contract(tf_groovy.cc UWVM_ROS1_TF_GROOVY_LINK)
    if(NOT UWVM_ROS1_TF_GROOVY_LINK)
        message(FATAL_ERROR "Selected SDK lacks a linkable public tf2 Buffer with explicit debug=false")
    endif()
    set(_uwvm_ros1_tf_feature "tf2::Buffer")
    list(APPEND CMAKE_REQUIRED_DEFINITIONS -DUWVM_ROS1_TF_BUFFER_IN_TF2=1)
    target_compile_definitions(uwvm-ros1-sdk INTERFACE UWVM_ROS1_TF_BUFFER_IN_TF2=1)
endif()
uwvm_ros1_compile_contract(native_api.cc UWVM_ROS1_PUBLIC_API_LINK)
if(NOT UWVM_ROS1_PUBLIC_API_LINK)
    message(FATAL_ERROR "Selected ROS1 SDK lacks a required public callback/XML-RPC/standard-interface API; inspect CMakeError.log. No feature was silently disabled.")
endif()
set(_uwvm_ros1_legacy_tf false)
if(NOT UWVM_ROS1_TF_MODERN_LINK)
    set(_uwvm_ros1_legacy_tf true)
endif()
set(_uwvm_ros1_backport_Trigger false)
set(_uwvm_ros1_backport_SetBool false)
foreach(_uwvm_service IN LISTS _uwvm_ros1_missing_services)
    set(_uwvm_ros1_backport_${_uwvm_service} true)
endforeach()
# These booleans are compile/link feature facts only. The external matrix owns
# SDK/tool identities and all native/Guest execution verdicts. In particular,
# the optional backport/legacy booleans are selections, not missing features.
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/uwvm_ros1_features.json.tmp"
    "{\"format_version\":1,\"backend\":\"ros1\",\"cxx_standard\":${UWVM_ROS1_CXX_STANDARD},\"features\":{\"cxx17_library\":true,\"roscpp_string_abi_link\":true,\"xmlrpc_bounded_api\":true,\"tf_buffer\":true,\"tf_buffer_legacy_namespace\":${_uwvm_ros1_legacy_tf},\"std_srvs_trigger\":true,\"std_srvs_set_bool\":true,\"trigger_generated_backport\":${_uwvm_ros1_backport_Trigger},\"set_bool_generated_backport\":${_uwvm_ros1_backport_SetBool},\"native_public_api\":true}}\n")
file(RENAME "${CMAKE_CURRENT_BINARY_DIR}/uwvm_ros1_features.json.tmp" "${CMAKE_CURRENT_BINARY_DIR}/uwvm_ros1_features.json")
message(STATUS "ROS1 target contracts compiled and linked; TF=${_uwvm_ros1_tf_feature}; selected string ABI=${UWVM_ROS1_SELECTED_CXX11_ABI}; generated standard services=${_uwvm_ros1_missing_services}. No target program was executed.")
if(_uwvm_ros1_saved_try_compile_type)
    set(CMAKE_TRY_COMPILE_TARGET_TYPE "${_uwvm_ros1_saved_try_compile_type}")
else()
    unset(CMAKE_TRY_COMPILE_TARGET_TYPE)
endif()
