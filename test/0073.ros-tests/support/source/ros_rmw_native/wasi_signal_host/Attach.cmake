# Source-only attachment recipe; not a stand-alone substitute Runtime build.
function(uwvm_attach_signal_host_contract actual_runtime_driver composed_source_root)
  if(NOT TARGET "${actual_runtime_driver}")
    message(FATAL_ERROR "A real existing Native Runtime driver target is required")
  endif()
  get_target_property(kind "${actual_runtime_driver}" TYPE)
  if(NOT kind STREQUAL "EXECUTABLE")
    message(FATAL_ERROR "Attach only to the actual executable Runtime contract driver")
  endif()
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "This optional Host counterpart uses the admitted Linux pipe/fd Runtime")
  endif()
  set(api "${composed_source_root}/src/uwvm2/runtime/lib/uwvm_runtime_threaded_profile_api.h")
  set(helper "${composed_source_root}/src/uwvm2/runtime/lib/uwvm_runtime_threaded_signal_host.h")
  set(fast_io "${composed_source_root}/third-parties/fast_io/include/fast_io.h")
  if(NOT EXISTS "${api}" OR NOT EXISTS "${helper}" OR NOT EXISTS "${fast_io}")
    message(FATAL_ERROR "The actual composed Source/helper and vendored fast_io are mandatory")
  endif()
  # Quoted Runtime includes must resolve inside Root's composed source tree.
  # Adding an include directory cannot override an old .cpp's adjacent header.
  target_sources("${actual_runtime_driver}" PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/host_contract.cc")
  target_include_directories("${actual_runtime_driver}" PRIVATE
    "${composed_source_root}/src" "${composed_source_root}/third-parties/fast_io/include")
  if(MSVC)
    message(FATAL_ERROR "Linux Native Runtime contract cannot use MSVC")
  else()
    target_compile_options("${actual_runtime_driver}" PRIVATE -UNDEBUG)
  endif()
endfunction()
