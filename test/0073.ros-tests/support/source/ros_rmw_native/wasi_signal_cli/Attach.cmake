function(uwvm_attach_signal_cli_contract actual_runtime_driver actual_composed_source)
  if(NOT TARGET "${actual_runtime_driver}")
    message(FATAL_ERROR "A genuine existing Runtime driver is required")
  endif()
  get_target_property(_kind "${actual_runtime_driver}" TYPE)
  if(NOT _kind STREQUAL "EXECUTABLE")
    message(FATAL_ERROR "The pure contracts must link the real executable Runtime closure")
  endif()
  foreach(_relative src/uwvm2/uwvm/run/threaded_signal_cli.h src/uwvm2/runtime/lib/uwvm_runtime_threaded_signal_host.h third-parties/fast_io/include/fast_io.h)
    if(NOT EXISTS "${actual_composed_source}/${_relative}")
      message(FATAL_ERROR "Missing actual source dependency: ${_relative}")
    endif()
  endforeach()
  target_sources("${actual_runtime_driver}" PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/policy_contract.cc")
  target_include_directories("${actual_runtime_driver}" PRIVATE "${actual_composed_source}/src" "${actual_composed_source}/third-parties/fast_io/include")
endfunction()
