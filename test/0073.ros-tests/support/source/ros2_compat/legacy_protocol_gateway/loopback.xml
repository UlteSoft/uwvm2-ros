<?xml version="1.0" encoding="UTF-8"?>
<!-- Trusted fixture transport selection. The external network namespace must
     independently contain only loopback; this profile is not the sandbox. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>uwvm_fixture_loopback_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="uwvm_fixture_loopback" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports><transport_id>uwvm_fixture_loopback_udp</transport_id></userTransports>
    </rtps>
  </participant>
</profiles>
