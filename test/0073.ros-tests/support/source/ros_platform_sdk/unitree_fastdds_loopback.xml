<?xml version="1.0" encoding="UTF-8"?>
<!-- Explicit native-only UDPv4 fixture, confined to IPv4 loopback. No Guest
     permission or robot endpoint is configured here. Builtin SHM is disabled.
     Fast DDS 2.6 syntax: https://fast-dds.docs.eprosima.com/en/2.6.x/fastdds/transport/udp/udp.html -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>unitree_fixture_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="unitree_fixture" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>unitree_fixture_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
