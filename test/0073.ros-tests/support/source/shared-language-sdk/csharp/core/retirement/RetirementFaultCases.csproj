<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RosSdkSource Condition="'$(RosSdkSource)' == '' And Exists('$(MSBuildThisFileDirectory)../../Uwvm.RosWasm.csproj')">$(MSBuildThisFileDirectory)../..</RosSdkSource>
    <TargetFramework>net8.0</TargetFramework><OutputType>Exe</OutputType><Nullable>enable</Nullable>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier><RuntimeFrameworkVersion>8.0.15</RuntimeFrameworkVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);UWVM_ROSWASM_RETIREMENT_FAULT_TESTS</DefineConstants>
    <DefineConstants Condition="'$(RosBackend)' == '1'">$(DefineConstants);UWVM_ROS1</DefineConstants>
    <DefineConstants Condition="'$(RosBackend)' == '2'">$(DefineConstants);UWVM_ROS2</DefineConstants>
    <WasmBuildNative>true</WasmBuildNative><WasmSingleFileBundle>true</WasmSingleFileBundle>
    <InvariantGlobalization>true</InvariantGlobalization><InvariantTimezone>true</InvariantTimezone>
    <WasmNativeStrip>false</WasmNativeStrip><WasmNativeDebugSymbols>true</WasmNativeDebugSymbols>
    <RunAOTCompilation>false</RunAOTCompilation><PublishTrimmed>true</PublishTrimmed><DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup><Compile Include="$(RosSdkSource)/RosWasm/**/*.cs" /><Compile Include="RetirementFaultCases.cs" /></ItemGroup>
  <Import Project="$(RosSdkSource)/NativeBridge.targets" Condition="'$(RosSdkSource)' != ''" />
  <Target Name="RequireExplicitSdkSource" BeforeTargets="PrepareForBuild"><Error Condition="'$(RosSdkSource)' == '' Or !Exists('$(RosSdkSource)/NativeBridge.targets')" Text="Supply the actual RosSdkSource package after test relocation; no host/bridge fallback." /></Target>
</Project>
