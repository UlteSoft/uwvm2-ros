 (import "wasi_snapshot_preview1" "clock_time_get" (func $clock (param i32 i64 i32) (result i32)))
 (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
 (memory (export "memory") 1)
 (data (i32.const 0) "pub") (data (i32.const 32) "sub") (data (i32.const 48) "server")
 (data (i32.const 128) "\05\00\00\00hello") (data (i32.const 160) "READY_TRAP\0a")
 (func $check (param $e i32) (if (local.get $e) (then (call $exit (local.get $e)))))
 (func $delay (param $ns i64) (local $start i64)
  (call $check (call $clock (i32.const 1) (i64.const 1) (i32.const 64)))
  (local.set $start (i64.load (i32.const 64)))
  (loop $wait
   (call $check (call $clock (i32.const 1) (i64.const 1) (i32.const 72)))
   (br_if $wait (i64.lt_u (i64.sub (i64.load (i32.const 72)) (local.get $start)) (local.get $ns)))))
 (func (export "_start") (local $n i32)
  (call $check (call $open (i32.const 0) (i64.const 0) (i64.const 3) (i64.const 8)))
  (call $check (call $open (i32.const 0) (i64.const 32) (i64.const 3) (i64.const 24)))
  (call $check (call $open (i32.const 0) (i64.const 48) (i64.const 6) (i64.const 40)))
  (call $check (call $subscribe (i64.load (i32.const 24))))
  (call $check (call $advertise (i64.load (i32.const 40))))
  (loop $publish
   (call $check (call $publish (i64.load (i32.const 8)) (i32.const 0) (i64.const 128) (i64.const 9)))
   (call $delay (i64.const 500000000))
   (local.set $n (i32.add (local.get $n) (i32.const 1)))
   (br_if $publish (i32.lt_u (local.get $n) (i32.const 10))))
  (i32.store (i32.const 96) (i32.const 160)) (i32.store (i32.const 100) (i32.const 11))
  (call $check (call $write (i32.const 1) (i32.const 96) (i32.const 1) (i32.const 104)))
  (call $delay (i64.const 1000000000))
  unreachable))
