(module
  (import "uwvm_ros1_v1" "capability_open" (func $open (param i32 i64 i64 i64) (result i32)))
  (import "uwvm_ros1_v1" "topic_publish" (func $publish (param i64 i32 i64 i64) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $exit (param i32)))
  (import "wasi_snapshot_preview1" "clock_time_get" (func $clock (param i32 i64 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "pub")
  (data (i32.const 8192) "\01")
  (func $check (param $e i32) (if (local.get $e) (then (call $exit (local.get $e)))))
  (func $delay (param $n i64) (local $start i64)
    (call $check (call $clock (i32.const 1) (i64.const 1) (i32.const 64)))
    (local.set $start (i64.load (i32.const 64)))
    (loop $wait
      (call $check (call $clock (i32.const 1) (i64.const 1) (i32.const 72)))
      (br_if $wait (i64.lt_u (i64.sub (i64.load (i32.const 72)) (local.get $start)) (local.get $n)))))
  (func (export "_start")
    (call $check (call $open (i32.const 0) (i64.const 0) (i64.const 3) (i64.const 8)))
    (call $check (call $publish (i64.load (i32.const 8)) (i32.const 0) (i64.const 8192) (i64.const 1)))
    (call $delay (i64.const 1000000000))
    (call $check (call $publish (i64.load (i32.const 8)) (i32.const 0) (i64.const 8192) (i64.const 1)))
    (call $delay (i64.const 1000000000))))
