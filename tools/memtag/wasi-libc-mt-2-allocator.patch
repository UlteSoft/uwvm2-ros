+#if defined(__wasilibc_dlmalloc_enable_memtag)
+/* Zero is reserved for allocator metadata and retired allocations. A fresh
+   active allocation must therefore use a nonzero tag. The execution-disabled
+   case must not loop on memtag.extract (which correctly returns zero then).
+   Retagging after reuse is still probabilistic; this is not a generation ID. */
+static void* memtag_new_allocation(void* mem, size_t bytes, int zero) {
+  if (__builtin_wasm_memtag_status(0) != 0) {
+    do {
+      mem = __builtin_wasm_memtag_random(0, mem);
+    } while (__builtin_wasm_memtag_extract(0, mem) == 0);
+  }
+  if (zero)
+    __builtin_wasm_memtag_storez(0, mem, bytes);
+  else
+    __builtin_wasm_memtag_store(0, mem, bytes);
+  return mem;
+}
+#endif
