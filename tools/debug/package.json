{
  "name": "uwvm-llvm-full-debug",
  "displayName": "UWVM LLVM Full Debug",
  "publisher": "uwvm",
  "version": "0.1.0",
  "description": "Attach VS Code to a host-authorized UWVM LLVM-full debugger broker",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebug"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "breakpoints": [
      {
        "language": "c"
      },
      {
        "language": "cpp"
      },
      {
        "language": "rust"
      },
      {
        "language": "wat"
      },
      {
        "language": "d"
      },
      {
        "language": "go"
      },
      {
        "language": "haskell"
      },
      {
        "language": "moonbit"
      },
      {
        "language": "nim"
      },
      {
        "language": "objective-c"
      },
      {
        "language": "objective-cpp"
      },
      {
        "language": "odin"
      },
      {
        "language": "swift"
      },
      {
        "language": "zig"
      },
      {
        "language": "typescript"
      },
      {
        "language": "assemblyscript"
      }
    ],
    "debuggers": [
      {
        "type": "uwvm-llvm-full",
        "label": "UWVM LLVM Full",
        "languages": [
          "c",
          "cpp",
          "rust",
          "wat",
          "d",
          "go",
          "haskell",
          "moonbit",
          "nim",
          "objective-c",
          "objective-cpp",
          "odin",
          "swift",
          "zig",
          "typescript",
          "assemblyscript"
        ],
        "configurationAttributes": {
          "attach": {
            "required": [],
            "properties": {
              "socketDir": {
                "type": "string",
                "description": "Host-owned Unix broker directory (Linux/macOS)."
              },
              "pipeName": {
                "type": "string",
                "description": "Host-owned Windows broker named pipe."
              },
              "capability": {
                "type": "string",
                "description": "Windows broker capability. Use a prompted input; never commit it."
              },
              "moduleId": {
                "type": "integer",
                "minimum": 0,
                "description": "Defined Wasm module for source breakpoints; defaults to 0."
              },
              "pythonPath": {
                "type": "string",
                "description": "Host Python 3 executable for the DAP adapter."
              },
              "stepLevel": {
                "type": "string",
                "enum": [
                  "source",
                  "wasm",
                  "native"
                ],
                "default": "source",
                "description": "Default statement stepping level. Source requires embedded -g DWARF; wasm/native stepIn executes exactly one Wasm/native instruction. Explicit line/instruction requests remain source/native. Native enables bounded current-function disassembly display after a real owned-code query; source/wasm references do not grant native code access."
              },
              "sourceMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "description": "Explicit compiler-root to local-directory mapping, e.g. /sdk and /application. Used for source display and reverse mapping of source breakpoints; does not grant guest filesystem access."
              },
              "transportProfile": {
                "type": "string",
                "description": "Absolute host-owned profile generated by import_ide.py. Local or verified OpenSSH stdio transport; no public DAP listener."
              },
              "startupTimeoutSeconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Optional Linux full-JIT first-reply deadline in seconds. Omit to wait for authenticated VM readiness, original VM exit, or IDE cancellation."
              },
              "debugPermissions": {
                "type": "string",
                "enum": [
                  "full",
                  "read-only",
                  "limited",
                  "none"
                ],
                "description": "Expected immutable VM launch permissions. Verified against the authenticated VM, never an upgrade. none disables debugger attachment."
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "UWVM LLVM Full: attach to Unix broker",
            "description": "Attach after an owner-authorized Linux/macOS broker has launched the VM.",
            "body": {
              "type": "uwvm-llvm-full",
              "request": "attach",
              "name": "UWVM LLVM Full (Unix)",
              "socketDir": "${1:/path/to/private/broker}",
              "moduleId": 0,
              "stepLevel": "source"
            }
          },
          {
            "label": "UWVM LLVM Full: attach to Windows broker",
            "description": "Attach to an owner-authorized named pipe with a prompted capability.",
            "body": {
              "type": "uwvm-llvm-full",
              "request": "attach",
              "name": "UWVM LLVM Full (Windows)",
              "pipeName": "${1:\\\\.\\pipe\\uwvm-debug-host-...}",
              "capability": "${input:uwvmDebugCapability}",
              "moduleId": 0,
              "stepLevel": "source"
            }
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "d",
        "aliases": [
          "D"
        ],
        "extensions": [
          ".d"
        ]
      },
      {
        "id": "haskell",
        "aliases": [
          "Haskell"
        ],
        "extensions": [
          ".hs",
          ".lhs"
        ]
      },
      {
        "id": "moonbit",
        "aliases": [
          "MoonBit"
        ],
        "extensions": [
          ".mbt"
        ]
      },
      {
        "id": "nim",
        "aliases": [
          "Nim"
        ],
        "extensions": [
          ".nim"
        ]
      },
      {
        "id": "odin",
        "aliases": [
          "Odin"
        ],
        "extensions": [
          ".odin"
        ]
      },
      {
        "id": "zig",
        "aliases": [
          "Zig"
        ],
        "extensions": [
          ".zig"
        ]
      },
      {
        "id": "wat",
        "aliases": [
          "WebAssembly Text"
        ],
        "extensions": [
          ".wat"
        ]
      }
    ],
    "commands": [
      {
        "command": "uwvm.showMemoryTags",
        "title": "UWVM: Show Memory Tags"
      },
      {
        "command": "uwvm.showDiagnostics",
        "title": "UWVM: Show Diagnostics and Permissions"
      },
      {
        "command": "uwvm.dump",
        "title": "UWVM: Save Wasm Dump (Current Permissions)"
      }
    ]
  }
}
