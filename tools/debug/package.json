{
  "name": "uwvm-llvm-full-debug",
  "displayName": "UWVM LLVM Full Debug",
  "publisher": "uwvm",
  "version": "0.1.0",
  "description": "Attach VS Code to a host-authorized UWVM LLVM-full debugger broker",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebug",
    "onView:uwvm.tools"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "breakpoints": [
      {
        "language": "c"
      },
      {
        "language": "cpp"
      },
      {
        "language": "rust"
      },
      {
        "language": "wat"
      },
      {
        "language": "d"
      },
      {
        "language": "go"
      },
      {
        "language": "haskell"
      },
      {
        "language": "moonbit"
      },
      {
        "language": "nim"
      },
      {
        "language": "objective-c"
      },
      {
        "language": "objective-cpp"
      },
      {
        "language": "odin"
      },
      {
        "language": "swift"
      },
      {
        "language": "zig"
      },
      {
        "language": "typescript"
      },
      {
        "language": "assemblyscript"
      },
      {
        "language": "uwvm-wasm-disassembly"
      }
    ],
    "debuggers": [
      {
        "type": "uwvm-llvm-full",
        "label": "UWVM LLVM Full",
        "languages": [
          "c",
          "cpp",
          "rust",
          "wat",
          "d",
          "go",
          "haskell",
          "moonbit",
          "nim",
          "objective-c",
          "objective-cpp",
          "odin",
          "swift",
          "zig",
          "typescript",
          "assemblyscript",
          "uwvm-wasm-disassembly"
        ],
        "configurationAttributes": {
          "attach": {
            "required": [],
            "properties": {
              "socketDir": {
                "type": "string",
                "description": "Host-owned Unix broker directory (Linux/macOS)."
              },
              "pipeName": {
                "type": "string",
                "description": "Host-owned Windows broker named pipe."
              },
              "capability": {
                "type": "string",
                "description": "Windows broker capability. Use a prompted input; never commit it."
              },
              "moduleId": {
                "type": "integer",
                "minimum": 0,
                "description": "Defined Wasm module for source breakpoints; defaults to 0."
              },
              "pythonPath": {
                "type": "string",
                "description": "Host Python 3 executable for the DAP adapter."
              },
              "stepLevel": {
                "type": "string",
                "enum": [
                  "source",
                  "wasm",
                  "native"
                ],
                "default": "source",
                "description": "Default statement stepping level. Source requires embedded -g DWARF; wasm/native stepIn executes exactly one Wasm/native instruction. Explicit line/instruction requests remain source/native. Native enables bounded current-function disassembly display after a real owned-code query; source/wasm references do not grant native code access."
              },
              "sourceMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "description": "Explicit compiler-root to local-directory mapping, e.g. /sdk and /application. Used for source display and reverse mapping of source breakpoints; does not grant guest filesystem access."
              },
              "transportProfile": {
                "type": "string",
                "description": "Absolute host-owned profile generated by import_ide.py. Local or verified OpenSSH stdio transport; no public DAP listener."
              },
              "startupTimeoutSeconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Optional Linux full-JIT first-reply deadline in seconds. Omit to wait for authenticated VM readiness, original VM exit, or IDE cancellation."
              },
              "debugPermissions": {
                "type": "string",
                "enum": [
                  "full",
                  "read-only",
                  "limited",
                  "none"
                ],
                "description": "Expected immutable VM launch permissions. Verified against the authenticated VM, never an upgrade. none disables debugger attachment."
              },
              "updateSocketDir": {
                "type": "string",
                "description": "Independent signed-update socket directory on the VM host. Separate from debugger display permissions; forwards existing authorized UUP1 frames only."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Keep the authenticated initial entry stop after attach. Generated runtime launch profiles default to false and continue once, after breakpoints are configured. Existing breakpoint, pause and fault stops are never auto-resumed. Restart reconnects; it does not reset this host-owned VM."
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "UWVM LLVM Full: attach to Unix broker",
            "description": "Attach after an owner-authorized Linux/macOS broker has launched the VM.",
            "body": {
              "type": "uwvm-llvm-full",
              "request": "attach",
              "name": "UWVM LLVM Full (Unix)",
              "socketDir": "${1:/path/to/private/broker}",
              "moduleId": 0,
              "stepLevel": "source"
            }
          },
          {
            "label": "UWVM LLVM Full: attach to Windows broker",
            "description": "Attach to an owner-authorized named pipe with a prompted capability.",
            "body": {
              "type": "uwvm-llvm-full",
              "request": "attach",
              "name": "UWVM LLVM Full (Windows)",
              "pipeName": "${1:\\\\.\\pipe\\uwvm-debug-host-...}",
              "capability": "${input:uwvmDebugCapability}",
              "moduleId": 0,
              "stepLevel": "source"
            }
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "d",
        "aliases": [
          "D"
        ],
        "extensions": [
          ".d"
        ]
      },
      {
        "id": "haskell",
        "aliases": [
          "Haskell"
        ],
        "extensions": [
          ".hs",
          ".lhs"
        ]
      },
      {
        "id": "moonbit",
        "aliases": [
          "MoonBit"
        ],
        "extensions": [
          ".mbt"
        ]
      },
      {
        "id": "nim",
        "aliases": [
          "Nim"
        ],
        "extensions": [
          ".nim"
        ]
      },
      {
        "id": "odin",
        "aliases": [
          "Odin"
        ],
        "extensions": [
          ".odin"
        ]
      },
      {
        "id": "zig",
        "aliases": [
          "Zig"
        ],
        "extensions": [
          ".zig"
        ]
      },
      {
        "id": "wat",
        "aliases": [
          "WebAssembly Text"
        ],
        "extensions": [
          ".wat"
        ]
      },
      {
        "id": "uwvm-wasm-disassembly",
        "aliases": [
          "UWVM Wasm Disassembly"
        ]
      }
    ],
    "commands": [
      {
        "command": "uwvm.openMemory",
        "title": "UWVM: Open Memory Window",
        "icon": "$(table)"
      },
      {
        "command": "uwvm.openRegisters",
        "title": "UWVM: Open Registers Window",
        "icon": "$(symbol-numeric)"
      },
      {
        "command": "uwvm.openWasip1",
        "title": "UWVM: Open WASI Window",
        "icon": "$(folder-opened)"
      },
      {
        "command": "uwvm.openRos",
        "title": "UWVM: Open ROS Window",
        "icon": "$(radio-tower)"
      },
      {
        "command": "uwvm.writeMemory",
        "title": "UWVM: Write Bytes in Current Memory Window"
      },
      {
        "command": "uwvm.submitSignedUpdate",
        "title": "UWVM: Submit Authorized Hot Update Request",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "uwvm.showMemoryTags",
        "title": "UWVM: Show Memory Tags"
      },
      {
        "command": "uwvm.showDiagnostics",
        "title": "UWVM: Show Diagnostics and Permissions"
      },
      {
        "command": "uwvm.dump",
        "title": "UWVM: Save Wasm Dump (Current Permissions)"
      },
      {
        "command": "uwvm.levelSource",
        "title": "UWVM: Source Level",
        "icon": "$(file-code)"
      },
      {
        "command": "uwvm.levelWasm",
        "title": "UWVM: Wasm Level",
        "icon": "$(symbol-method)"
      },
      {
        "command": "uwvm.levelAsm",
        "title": "UWVM: JIT Assembly Level",
        "icon": "$(code)"
      },
      {
        "command": "uwvm.openWasiCalls",
        "title": "UWVM: Recorded WASIp1 Calls",
        "icon": "$(list-tree)"
      },
      {
        "command": "uwvm.openRosCalls",
        "title": "UWVM: Recorded ROS Calls",
        "icon": "$(list-tree)"
      },
      {
        "command": "uwvm.openBreakpoints",
        "title": "UWVM: All Breakpoints",
        "icon": "$(debug-breakpoint)"
      },
      {
        "command": "uwvm.openWasmInstructions",
        "title": "UWVM: Open Wasm Instruction View",
        "icon": "$(symbol-method)"
      },
      {
        "command": "uwvm.switchFromSource",
        "title": "UWVM: S · Source — Click to change instruction level",
        "icon": {
          "light": "icons/level-S-light.svg",
          "dark": "icons/level-S-dark.svg"
        }
      },
      {
        "command": "uwvm.switchFromWasm",
        "title": "UWVM: W · Wasm — Click to change instruction level",
        "icon": {
          "light": "icons/level-W-light.svg",
          "dark": "icons/level-W-dark.svg"
        }
      },
      {
        "command": "uwvm.switchFromAsm",
        "title": "UWVM: A · Assembly — Click to change instruction level",
        "icon": {
          "light": "icons/level-A-light.svg",
          "dark": "icons/level-A-dark.svg"
        }
      }
    ],
    "menus": {
      "debug/toolBar": [
        {
          "command": "uwvm.openMemory",
          "when": "debugType == uwvm-llvm-full",
          "group": "navigation@100"
        },
        {
          "command": "uwvm.switchFromSource",
          "when": "debugType == uwvm-llvm-full && uwvm.stepLevel == source",
          "group": "navigation@101"
        },
        {
          "command": "uwvm.switchFromWasm",
          "when": "debugType == uwvm-llvm-full && uwvm.stepLevel == wasm",
          "group": "navigation@101"
        },
        {
          "command": "uwvm.switchFromAsm",
          "when": "debugType == uwvm-llvm-full && uwvm.stepLevel == native",
          "group": "navigation@101"
        }
      ],
      "view/title": [
        {
          "command": "uwvm.showDiagnostics",
          "when": "view == uwvm.tools",
          "group": "navigation"
        },
        {
          "command": "uwvm.openMemory",
          "when": "view == uwvm.tools",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "uwvm.levelSource",
          "when": "debugType == uwvm-llvm-full",
          "group": "uwvm@0"
        },
        {
          "command": "uwvm.levelWasm",
          "when": "debugType == uwvm-llvm-full",
          "group": "uwvm@1"
        },
        {
          "command": "uwvm.levelAsm",
          "when": "debugType == uwvm-llvm-full",
          "group": "uwvm@2"
        }
      ]
    },
    "configuration": {
      "title": "UWVM independent signed updates",
      "properties": {
        "uwvm.update.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Absolute local Python executable for independent update forwarding. Empty uses an absolute interpreter from the active debug configuration or /usr/bin/python3 on Unix; on Windows select an installed Python executable. No debugger session is required."
        },
        "uwvm.update.socketDir": {
          "type": "string",
          "default": "",
          "description": "Independent update relay directory on the local Linux VM host."
        },
        "uwvm.update.transportProfile": {
          "type": "string",
          "default": "",
          "description": "Host-owned imported local or verified SSH profile containing updateSocketDir. Works when debugger permission is none."
        }
      }
    },
    "grammars": [
      {
        "language": "uwvm-wasm-disassembly",
        "scopeName": "source.uwvm-wasm-disassembly",
        "path": "./syntaxes/uwvm-wasm.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[uwvm-wasm-disassembly]": {
        "editor.hover.delay": 350
      }
    },
    "views": {
      "debug": [
        {
          "id": "uwvm.tools",
          "name": "UWVM Debugger",
          "visibility": "visible"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "uwvm.wasmInstructions",
        "displayName": "UWVM Wasm Instructions",
        "selector": [
          {
            "filenamePattern": "**/*.uwvm-wat"
          }
        ],
        "priority": "default"
      }
    ]
  }
}
