{
  "name": "uwvm-llvm-full-debug",
  "displayName": "UWVM LLVM Full Debug",
  "publisher": "uwvm",
  "version": "0.1.0",
  "description": "Attach VS Code to a host-authorized UWVM LLVM-full debugger broker",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebug",
    "onView:uwvm.tools",
    "onCommand:uwvm.submitSignedUpdate"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "breakpoints": [
      {
        "language": "c"
      },
      {
        "language": "cpp"
      },
      {
        "language": "rust"
      },
      {
        "language": "wat"
      },
      {
        "language": "d"
      },
      {
        "language": "go"
      },
      {
        "language": "haskell"
      },
      {
        "language": "moonbit"
      },
      {
        "language": "nim"
      },
      {
        "language": "objective-c"
      },
      {
        "language": "objective-cpp"
      },
      {
        "language": "odin"
      },
      {
        "language": "swift"
      },
      {
        "language": "zig"
      },
      {
        "language": "typescript"
      },
      {
        "language": "assemblyscript"
      },
      {
        "language": "uwvm-wasm-disassembly"
      }
    ],
    "debuggers": [
      {
        "type": "uwvm-llvm-full",
        "label": "UWVM LLVM Full",
        "languages": [
          "c",
          "cpp",
          "rust",
          "wat",
          "d",
          "go",
          "haskell",
          "moonbit",
          "nim",
          "objective-c",
          "objective-cpp",
          "odin",
          "swift",
          "zig",
          "typescript",
          "assemblyscript",
          "uwvm-wasm-disassembly"
        ],
        "configurationAttributes": {
          "attach": {
            "required": [],
            "properties": {
              "socketDir": {
                "type": "string",
                "description": "Host-owned Unix broker directory (Linux/macOS)."
              },
              "pipeName": {
                "type": "string",
                "description": "Host-owned Windows broker named pipe."
              },
              "capability": {
                "type": "string",
                "description": "Windows broker capability. Use a prompted input; never commit it."
              },
              "moduleId": {
                "type": "integer",
                "minimum": 0,
                "description": "Defined Wasm module for source breakpoints; defaults to 0."
              },
              "pythonPath": {
                "type": "string",
                "description": "Host Python 3 executable for the DAP adapter."
              },
              "stepLevel": {
                "type": "string",
                "enum": [
                  "source",
                  "wasm",
                  "native"
                ],
                "default": "source",
                "description": "Default statement stepping level. Source requires embedded -g DWARF; wasm/native stepIn executes exactly one Wasm/native instruction. Explicit line/instruction requests remain source/native. Inspectable source and Wasm stops receive an authenticated current LLVM-JIT display reference; it grants disassembly display only, never host-code access or mutation."
              },
              "sourceMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "description": "Explicit compiler-root to local-directory mapping, e.g. /sdk and /application. Used for source display and reverse mapping of source breakpoints; does not grant guest filesystem access."
              },
              "transportProfile": {
                "type": "string",
                "description": "Absolute host-owned profile generated by import_ide.py. Local or verified OpenSSH stdio transport; no public DAP listener."
              },
              "startupTimeoutSeconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Optional Linux full-JIT first-reply deadline in seconds. Omit to wait for authenticated VM readiness, original VM exit, or IDE cancellation."
              },
              "debugPermissions": {
                "type": "string",
                "enum": [
                  "full",
                  "read-only",
                  "limited",
                  "none"
                ],
                "description": "Expected immutable VM launch permissions. Verified against the authenticated VM, never an upgrade. none disables debugger attachment."
              },
              "updateSocketDir": {
                "type": "string",
                "description": "Independent signed-update socket directory on the VM host. Separate from debugger display permissions; forwards existing authorized UUP1 frames only."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Keep the authenticated initial entry stop after attach. Generated runtime launch profiles default to false and continue once, after breakpoints are configured. Existing breakpoint, pause and fault stops are never auto-resumed. Restart reconnects; it does not reset this host-owned VM."
              },
              "stepLevelLocked": {
                "type": "boolean",
                "default": false,
                "description": "Lock the selected Source/Wasm/Assembly stepping level. Breakpoint hits still reveal their own view; unlock before changing levels."
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "UWVM LLVM Full: attach to Unix broker",
            "description": "Attach after an owner-authorized Linux/macOS broker has launched the VM.",
            "body": {
              "type": "uwvm-llvm-full",
              "request": "attach",
              "name": "UWVM LLVM Full (Unix)",
              "socketDir": "${1:/path/to/private/broker}",
              "moduleId": 0,
              "stepLevel": "source"
            }
          },
          {
            "label": "UWVM LLVM Full: attach to Windows broker",
            "description": "Attach to an owner-authorized named pipe with a prompted capability.",
            "body": {
              "type": "uwvm-llvm-full",
              "request": "attach",
              "name": "UWVM LLVM Full (Windows)",
              "pipeName": "${1:\\\\.\\pipe\\uwvm-debug-host-...}",
              "capability": "${input:uwvmDebugCapability}",
              "moduleId": 0,
              "stepLevel": "source"
            }
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "d",
        "aliases": [
          "D"
        ],
        "extensions": [
          ".d"
        ]
      },
      {
        "id": "haskell",
        "aliases": [
          "Haskell"
        ],
        "extensions": [
          ".hs",
          ".lhs"
        ]
      },
      {
        "id": "moonbit",
        "aliases": [
          "MoonBit"
        ],
        "extensions": [
          ".mbt"
        ]
      },
      {
        "id": "nim",
        "aliases": [
          "Nim"
        ],
        "extensions": [
          ".nim"
        ]
      },
      {
        "id": "odin",
        "aliases": [
          "Odin"
        ],
        "extensions": [
          ".odin"
        ]
      },
      {
        "id": "zig",
        "aliases": [
          "Zig"
        ],
        "extensions": [
          ".zig"
        ]
      },
      {
        "id": "wat",
        "aliases": [
          "WebAssembly Text"
        ],
        "extensions": [
          ".wat"
        ]
      },
      {
        "id": "uwvm-wasm-disassembly",
        "aliases": [
          "UWVM Wasm Disassembly"
        ]
      }
    ],
    "commands": [
      {
        "command": "uwvm.openMemory",
        "title": "Open Memory",
        "category": "UWVM",
        "icon": "$(database)"
      },
      {
        "command": "uwvm.openRegisters",
        "title": "Open Registers",
        "category": "UWVM",
        "icon": "$(symbol-numeric)"
      },
      {
        "command": "uwvm.openWasip1",
        "title": "Open WASI",
        "category": "UWVM",
        "icon": "$(terminal)"
      },
      {
        "command": "uwvm.openWasithread",
        "title": "UWVM: Open WASI Threads",
        "category": "UWVM"
      },
      {
        "command": "uwvm.openScene",
        "title": "Open u2rosv2 Robot Scene (in development)",
        "category": "UWVM",
        "icon": "$(shield)"
      },
      {
        "command": "uwvm.openPreloadDl",
        "title": "Open preloaddl Inventory",
        "category": "UWVM",
        "icon": "$(library)"
      },
      {
        "command": "uwvm.openRos",
        "title": "Open u2rosv1 (ros1 / ros2)",
        "category": "UWVM",
        "icon": "$(radio-tower)"
      },
      {
        "command": "uwvm.writeMemory",
        "title": "Write Bytes in Focused Memory Window",
        "category": "UWVM"
      },
      {
        "command": "uwvm.submitSignedUpdate",
        "title": "Submit Hot Update\u2026",
        "category": "UWVM",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "uwvm.showMemoryTags",
        "title": "Open Memory with Allocation Tags",
        "category": "UWVM",
        "icon": "$(tag)"
      },
      {
        "command": "uwvm.showDiagnostics",
        "title": "Show Diagnostics",
        "category": "UWVM",
        "icon": "$(pulse)"
      },
      {
        "command": "uwvm.dump",
        "title": "Save Wasm Dump\u2026",
        "category": "UWVM",
        "icon": "$(save)"
      },
      {
        "command": "uwvm.levelSource",
        "title": "Step Level: Source",
        "category": "UWVM",
        "icon": "$(file-code)"
      },
      {
        "command": "uwvm.levelWasm",
        "title": "Step Level: Wasm",
        "category": "UWVM",
        "icon": "$(symbol-method)"
      },
      {
        "command": "uwvm.levelAsm",
        "title": "Step Level: Assembly",
        "category": "UWVM",
        "icon": "$(chip)"
      },
      {
        "command": "uwvm.openBreakpoints",
        "title": "Open Breakpoint Manager",
        "category": "UWVM",
        "icon": "$(debug-breakpoint-conditional)"
      },
      {
        "command": "uwvm.openWasmInstructions",
        "title": "Open Wasm Instructions",
        "category": "UWVM",
        "icon": "$(symbol-method)"
      },
      {
        "command": "uwvm.switchFromSource",
        "title": "Step level: S \u00b7 Source (click to change)",
        "icon": {
          "light": "icons/level-S-light.svg",
          "dark": "icons/level-S-dark.svg"
        },
        "category": "UWVM"
      },
      {
        "command": "uwvm.switchFromWasm",
        "title": "Step level: W \u00b7 Wasm (click to change)",
        "icon": {
          "light": "icons/level-W-light.svg",
          "dark": "icons/level-W-dark.svg"
        },
        "category": "UWVM"
      },
      {
        "command": "uwvm.switchFromAsm",
        "title": "Step level: A \u00b7 Assembly (click to change)",
        "icon": {
          "light": "icons/level-A-light.svg",
          "dark": "icons/level-A-dark.svg"
        },
        "category": "UWVM"
      },
      {
        "command": "uwvm.switchLevel",
        "title": "Change Step Level\u2026",
        "category": "UWVM",
        "icon": "$(debug-step-into)"
      },
      {
        "command": "uwvm.explainUnavailable",
        "title": "Why Is This Unavailable?",
        "category": "UWVM"
      },
      {
        "command": "uwvm.toggleStepLock",
        "title": "Lock / unlock step level",
        "category": "UWVM",
        "icon": "$(lock)"
      },
      {
        "command": "uwvm.openWatch",
        "title": "Open Grouped Watch",
        "category": "UWVM",
        "icon": "$(eye)"
      },
      {
        "command": "uwvm.navigateBack",
        "title": "Navigate Back",
        "category": "UWVM",
        "icon": "$(arrow-left)",
        "enablement": "uwvm.canNavigateBack"
      },
      {
        "command": "uwvm.navigateForward",
        "title": "Navigate Forward",
        "category": "UWVM",
        "icon": "$(arrow-right)",
        "enablement": "uwvm.canNavigateForward"
      }
    ],
    "menus": {
      "debug/toolBar": [
        {
          "command": "uwvm.openMemory",
          "when": "debugType == uwvm-llvm-full",
          "group": "navigation@100"
        },
        {
          "command": "uwvm.switchFromSource",
          "when": "debugType == uwvm-llvm-full && uwvm.stepLevel == source",
          "group": "navigation@101"
        },
        {
          "command": "uwvm.switchFromWasm",
          "when": "debugType == uwvm-llvm-full && uwvm.stepLevel == wasm",
          "group": "navigation@101"
        },
        {
          "command": "uwvm.switchFromAsm",
          "when": "debugType == uwvm-llvm-full && uwvm.stepLevel == native",
          "group": "navigation@101"
        },
        {
          "command": "uwvm.navigateBack",
          "when": "debugType == uwvm-llvm-full",
          "group": "navigation@0"
        },
        {
          "command": "uwvm.navigateForward",
          "when": "debugType == uwvm-llvm-full",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "uwvm.openMemory",
          "when": "view == uwvm.tools",
          "group": "navigation@1"
        },
        {
          "command": "uwvm.openBreakpoints",
          "when": "view == uwvm.tools",
          "group": "navigation@2"
        },
        {
          "command": "uwvm.showDiagnostics",
          "when": "view == uwvm.tools",
          "group": "navigation@3"
        },
        {
          "command": "uwvm.submitSignedUpdate",
          "when": "view == uwvm.tools",
          "group": "more@1"
        },
        {
          "command": "uwvm.navigateBack",
          "when": "view == uwvm.tools",
          "group": "navigation@0"
        },
        {
          "command": "uwvm.navigateForward",
          "when": "view == uwvm.tools",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "uwvm.switchLevel",
          "when": "debugType == uwvm-llvm-full",
          "group": "uwvm@0"
        },
        {
          "command": "uwvm.openMemory",
          "when": "debugType == uwvm-llvm-full",
          "group": "uwvm@1"
        }
      ],
      "commandPalette": [
        {
          "command": "uwvm.explainUnavailable",
          "when": "false"
        },
        {
          "command": "uwvm.switchFromSource",
          "when": "false"
        },
        {
          "command": "uwvm.switchFromWasm",
          "when": "false"
        },
        {
          "command": "uwvm.switchFromAsm",
          "when": "false"
        },
        {
          "command": "uwvm.levelSource",
          "when": "uwvm.active"
        },
        {
          "command": "uwvm.levelWasm",
          "when": "uwvm.active"
        },
        {
          "command": "uwvm.levelAsm",
          "when": "uwvm.active"
        },
        {
          "command": "uwvm.switchLevel",
          "when": "uwvm.active"
        },
        {
          "command": "uwvm.writeMemory",
          "when": "activeWebviewPanelId =~ /^uwvm\\.memory/"
        }
      ],
      "debug/callstack/context": [
        {
          "command": "uwvm.openWasmInstructions",
          "when": "debugType == uwvm-llvm-full",
          "group": "uwvm@1"
        },
        {
          "command": "uwvm.openMemory",
          "when": "debugType == uwvm-llvm-full",
          "group": "uwvm@2"
        }
      ],
      "editor/title": [
        {
          "command": "uwvm.navigateBack",
          "when": "debugType == uwvm-llvm-full",
          "group": "navigation@0"
        },
        {
          "command": "uwvm.navigateForward",
          "when": "debugType == uwvm-llvm-full",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "UWVM independent signed updates",
      "properties": {
        "uwvm.update.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Absolute local Python executable for independent update forwarding. Empty uses an absolute interpreter from the active debug configuration or /usr/bin/python3 on Unix; on Windows select an installed Python executable. No debugger session is required."
        },
        "uwvm.update.socketDir": {
          "type": "string",
          "default": "",
          "description": "Independent update relay directory on the local Linux VM host."
        },
        "uwvm.update.transportProfile": {
          "type": "string",
          "default": "",
          "description": "Host-owned imported local or verified SSH profile containing updateSocketDir. Works when debugger permission is none."
        }
      }
    },
    "grammars": [
      {
        "language": "uwvm-wasm-disassembly",
        "scopeName": "source.uwvm-wasm-disassembly",
        "path": "./syntaxes/uwvm-wasm.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "debug.showVariableTypes": true,
      "workbench.colorCustomizations": {
        "debugTokenExpression.type": "#dcdcaa"
      },
      "[uwvm-wasm-disassembly]": {
        "editor.hover.delay": 350
      }
    },
    "views": {
      "debug": [
        {
          "id": "uwvm.tools",
          "name": "UWVM",
          "visibility": "visible",
          "icon": "$(debug-alt)"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "uwvm.wasmInstructions",
        "displayName": "UWVM Wasm Instructions",
        "selector": [
          {
            "filenamePattern": "**/*.uwvm-wat"
          }
        ],
        "priority": "default"
      }
    ],
    "keybindings": [
      {
        "command": "uwvm.switchLevel",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "inDebugMode && debugType == uwvm-llvm-full"
      },
      {
        "command": "uwvm.openMemory",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "inDebugMode && debugType == uwvm-llvm-full"
      },
      {
        "command": "uwvm.navigateBack",
        "key": "alt+left",
        "mac": "ctrl+-",
        "when": "debugType == uwvm-llvm-full && !inputFocus"
      },
      {
        "command": "uwvm.navigateForward",
        "key": "alt+right",
        "mac": "ctrl+shift+-",
        "when": "debugType == uwvm-llvm-full && !inputFocus"
      }
    ],
    "viewsWelcome": [
      {
        "view": "uwvm.tools",
        "contents": "No UWVM session is attached.\n[Run and Debug](command:workbench.view.debug)\nChoose a UWVM configuration and press F5. Inspector windows open from this view once the guest pauses.\n[Submit Hot Update\u2026](command:uwvm.submitSignedUpdate)",
        "when": "!uwvm.active"
      }
    ]
  }
}
